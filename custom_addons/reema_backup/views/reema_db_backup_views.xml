<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Backup Log list view ───────────────────────────────────────── -->
    <record id="view_reema_db_backup_list" model="ir.ui.view">
        <field name="name">reema.db.backup.list</field>
        <field name="model">reema.db.backup</field>
        <field name="arch" type="xml">
            <list string="Database Backups" create="false" edit="false" delete="true"
                  default_order="backup_date desc">
                <header>
                    <button name="action_take_backup" string="Take Backup Now"
                            type="object" class="btn-primary" display="always"
                            confirm="Take a database backup now? This may take a few seconds."/>
                </header>
                <field name="backup_date" string="Date &amp; Time" widget="datetime"/>
                <field name="filename" string="Filename"/>
                <field name="size_human" string="Size"/>
                <field name="state" string="Status" widget="badge"
                       decoration-success="state == 'success'"
                       decoration-danger="state == 'failed'"/>
                <field name="taken_by" string="Taken By"/>
                <button name="action_delete_file" string="Delete" type="object"
                        icon="fa-trash" title="Delete file and log entry"
                        confirm="This will permanently delete the backup file from disk. Are you sure?"/>
            </list>
        </field>
    </record>

    <!-- ── Backup detail form ─────────────────────────────────────────── -->
    <record id="view_reema_db_backup_form" model="ir.ui.view">
        <field name="name">reema.db.backup.form</field>
        <field name="model">reema.db.backup</field>
        <field name="arch" type="xml">
            <form string="Backup Detail" create="false" edit="false">
                <sheet>
                    <group>
                        <group string="Backup Info">
                            <field name="filename" readonly="1"/>
                            <field name="backup_date" readonly="1"/>
                            <field name="state" readonly="1" widget="badge"
                                   decoration-success="state == 'success'"
                                   decoration-danger="state == 'failed'"/>
                            <field name="size_human" readonly="1" string="File Size"/>
                            <field name="taken_by" readonly="1"/>
                        </group>
                        <group string="File Location">
                            <field name="backup_path" readonly="1" string="Path on Disk"/>
                        </group>
                    </group>
                    <group string="Notes / Error" invisible="not notes">
                        <field name="notes" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Window action ─────────────────────────────────────────────── -->
    <record id="action_reema_db_backup" model="ir.actions.act_window">
        <field name="name">Database Backup</field>
        <field name="res_model">reema.db.backup</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_reema_db_backup_list"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No backups yet.</p>
            <p>Click <strong>Take Backup Now</strong> to create your first database backup.</p>
        </field>
    </record>

</odoo>
