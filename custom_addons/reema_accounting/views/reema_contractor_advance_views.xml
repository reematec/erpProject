<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── List View ──────────────────────────────────────────────────── -->
    <record id="view_contractor_advance_list" model="ir.ui.view">
        <field name="name">reema.contractor.advance.list</field>
        <field name="model">reema.contractor.advance</field>
        <field name="arch" type="xml">
            <list string="Contractor Advances" duplicate="0" import="0">
                <header>
                    <button name="action_print_advance_overview" string="Print"
                            type="object" class="btn-secondary" icon="fa-print"
                            display="always"/>
                </header>
                <field name="name" string="Voucher No."/>
                <field name="partner_id" string="Contractor"/>
                <field name="date" string="Date"/>
                <field name="journal_id" string="Payment Method"/>
                <field name="advance_type" string="Type" widget="badge" optional="show"/>
                <field name="amount" string="Amount (PKR)" sum="Total"/>
                <field name="state" string="Status"
                       widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'posted'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- ── Form View ──────────────────────────────────────────────────── -->
    <record id="view_contractor_advance_form" model="ir.ui.view">
        <field name="name">reema.contractor.advance.form</field>
        <field name="model">reema.contractor.advance</field>
        <field name="arch" type="xml">
            <form string="Contractor Advance Voucher" duplicate="0">
                <header>
                    <button name="action_confirm"
                            string="Post"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"
                            confirm="Post this advance? Once posted it becomes read-only — mistakes are corrected via Reverse, not by editing."
                            confirm-label="Yes, Post"
                            cancel-label="Go Back"/>
                    <button name="action_void"
                            string="Void Voucher"
                            type="object"
                            invisible="state != 'draft'"
                            confirm="Void this draft voucher? It will be marked Cancelled and can no longer be posted."
                            confirm-label="Yes, Void"
                            cancel-label="Go Back"/>
                    <button name="action_reset_to_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state != 'cancelled' or move_id"/>
                    <button name="action_reverse"
                            string="Reverse"
                            type="object"
                            class="btn-danger"
                            invisible="state != 'posted'"
                            confirm="Reverse this advance? A reversing journal entry will be posted and this voucher will no longer count toward the contractor's outstanding advance. This cannot be undone."
                            confirm-label="Yes, Reverse"
                            cancel-label="Go Back"/>
                    <button name="action_print_advance_voucher"
                            string="Print"
                            type="object"
                            invisible="state == 'cancelled'"/>
                    <!-- Pure static HTML, not an Odoo <button> — deliberately not
                         routed through the form controller's button pipeline,
                         which saves the record before running ANY header button
                         (type="object" or type="action" alike, per Odoo's
                         form_controller.js beforeExecuteActionButton — every
                         click except a special="cancel" one calls record.save()
                         first). This is a plain read-only reference popup with
                         no relation to the record's data, so it must never save
                         anything, even implicitly. Bootstrap's dropdown JS is
                         already bundled and globally active in web.assets_backend,
                         so data-bs-toggle="dropdown" works with zero custom JS
                         and zero server round-trip. -->
                    <div class="dropdown d-inline-block align-middle" groups="base.group_user">
                        <a href="#" class="btn btn-link p-1" data-bs-toggle="dropdown"
                           aria-expanded="false" title="Status reference"
                           style="text-decoration:none;">
                            <i class="fa fa-info-circle" style="font-size:16px;"/>
                        </a>
                        <div class="dropdown-menu p-3" style="width:560px; max-width:90vw;">
                            <table class="table table-sm table-bordered" style="font-size:13px;">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:140px">Status</th>
                                        <th>What it means</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><span class="badge text-bg-info">Draft</span></td>
                                        <td>Voucher prepared but not yet posted. No journal entry exists — no funds have moved.</td>
                                    </tr>
                                    <tr>
                                        <td><span class="badge text-bg-success">Posted</span></td>
                                        <td>Advance has been paid — a <strong>Dr Advance Account / Cr Bank-Cash</strong> journal entry is posted. Fields become read-only.</td>
                                    </tr>
                                    <tr>
                                        <td><span class="badge text-bg-danger">Cancelled</span></td>
                                        <td>Either voided while still Draft (never posted), or Reversed after Posted (a reversing journal entry cancels out the original).</td>
                                    </tr>
                                </tbody>
                            </table>
                            <table class="table table-sm table-bordered mt-2" style="font-size:13px;">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:140px">Button</th>
                                        <th style="width:110px">Available when</th>
                                        <th>What it does</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><strong>Post</strong></td>
                                        <td>Draft</td>
                                        <td>Assigns the voucher number and creates the journal entry (Dr Advance / Cr Bank-Cash). Moves status to Posted.</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Void Voucher</strong></td>
                                        <td>Draft</td>
                                        <td>Cancels the voucher without posting anything — no journal entry ever existed. Moves status to Cancelled.</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Reset to Draft</strong></td>
                                        <td>Cancelled (voided only)</td>
                                        <td>Brings a voided draft back to Draft for editing/posting. Not available for Reversed vouchers.</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Reverse</strong></td>
                                        <td>Posted</td>
                                        <td>Posts a reversing journal entry to cancel out the original, then moves status to Cancelled. Used to correct a mistake instead of editing.</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Print</strong></td>
                                        <td>Draft / Posted</td>
                                        <td>Draft: unsigned copy for approval/signature. Posted: final signed copy.</td>
                                    </tr>
                                </tbody>
                            </table>
                            <table class="table table-sm table-bordered mt-2 mb-0" style="font-size:13px;">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:140px">Advance Type</th>
                                        <th>Meaning</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><span class="badge text-bg-secondary">Against Bill</span></td>
                                        <td>Expected to be recovered in one go on the contractor's next Contractor Bill.</td>
                                    </tr>
                                    <tr>
                                        <td><span class="badge text-bg-secondary">Long Term Advance</span></td>
                                        <td>Recovered gradually over several bills. The <strong>Deduction per Bill</strong> amount is shown as a suggested hint on this contractor's future Contractor Bills — not applied automatically.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"
                                   readonly="state != 'draft'"
                                   options="{'no_create': True, 'no_edit': True}"/>
                            <field name="outstanding_advance" invisible="not partner_id"/>
                            <field name="purpose" readonly="state != 'draft'"
                                   placeholder="e.g. Advance for July stitching batch"/>
                        </group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="journal_id" readonly="state != 'draft'"/>
                            <field name="journal_type" invisible="1"/>
                            <field name="bank_id" readonly="state != 'draft'"
                                   invisible="journal_type != 'bank'"
                                   options="{'no_create': True, 'no_edit': True}"/>
                            <field name="cheque_no" readonly="state != 'draft'"
                                   invisible="journal_type != 'bank'"
                                   placeholder="e.g. Cheque no. or transfer reference"/>
                            <field name="amount" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="advance_type" readonly="state != 'draft'" widget="radio"/>
                        </group>
                        <group>
                            <field name="deduction_per_bill" readonly="state != 'draft'"
                                   invisible="advance_type != 'long_term'"
                                   required="advance_type == 'long_term'"/>
                        </group>
                    </group>
                    <group invisible="not move_id and not reversal_move_id">
                        <field name="move_id" readonly="1" options="{'no_create': True, 'no_edit': True}"/>
                        <field name="reversal_move_id" readonly="1" invisible="not reversal_move_id"
                               options="{'no_create': True, 'no_edit': True}"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── Search View ────────────────────────────────────────────────── -->
    <record id="view_contractor_advance_search" model="ir.ui.view">
        <field name="name">reema.contractor.advance.search</field>
        <field name="model">reema.contractor.advance</field>
        <field name="arch" type="xml">
            <search string="Contractor Advances">
                <field name="name" string="Voucher No."/>
                <field name="partner_id" string="Contractor"/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Posted" name="filter_posted" domain="[('state', '=', 'posted')]"/>
                <filter string="Cancelled" name="filter_cancelled" domain="[('state', '=', 'cancelled')]"/>
                <group expand="0" string="Group By">
                    <filter string="Contractor" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Action + Menu ──────────────────────────────────────────────── -->
    <record id="action_contractor_advance" model="ir.actions.act_window">
        <field name="name">Contractor Advances</field>
        <field name="res_model">reema.contractor.advance</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

    <menuitem
        id="menu_contractor_advance"
        name="Contractor Advances"
        parent="menu_reema_accounting_contractors"
        action="action_contractor_advance"
        sequence="3"
        groups="account.group_account_manager"/>

</odoo>
