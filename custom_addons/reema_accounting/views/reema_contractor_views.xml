<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Contractor form: standalone primary view, used only by the Accounting app's
         Contractors action — adds Payable/Advance GL accounts directly on the record
         and hides the Sales & Purchase tab (contractors don't have pricelists/terms). -->
    <record id="view_contractor_form" model="ir.ui.view">
        <field name="name">reema.contractor.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//page[@name='sales_purchases']" position="after">
                <page string="Accounting" name="reema_accounting">
                    <group>
                        <field name="property_account_payable_id"
                               string="Account Payable"
                               options="{'no_create': True, 'no_edit': True}"/>
                        <field name="reema_advance_account_id"
                               string="Advance Account"
                               options="{'no_create': True, 'no_edit': True}"
                               help="Set only when this contractor has an active advance. Leave empty otherwise."/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Extension of the primary view — runs after base extensions, so can hide fields they add -->
    <record id="view_contractor_form_overrides" model="ir.ui.view">
        <field name="name">reema.contractor.form.overrides</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="view_contractor_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_contractor']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
        </field>
    </record>

    <!-- Action: contractors only, uses the dedicated form above -->
    <record id="action_reema_accounting_contractors" model="ir.actions.act_window">
        <field name="name">Contractors</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('supplier_rank', '>', 0), ('is_contractor', '=', True)]</field>
        <field name="context">{'default_supplier_rank': 1, 'default_is_contractor': True, 'reema_contractor_context': True}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': False}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_contractor_form')})]"/>
    </record>

    <!-- Top-level "Contractors" app-bar menu — sibling of Customers/Vendors/Accounting/
         Reporting/Configuration, positioned right after Vendors(3). Core's "Accounting"
         (Journal Entries) menu is bumped from its default sequence=4 to 6 to make room.
         No action of its own (same pattern as Vendors/Customers), just groups the
         contractor partner list and the two contractor-bill queues that used to live
         under Vendors. -->
    <record id="account.menu_finance_entries" model="ir.ui.menu">
        <field name="sequence">6</field>
    </record>

    <menuitem
        id="menu_reema_accounting_contractors"
        name="Contractors"
        parent="account.menu_finance"
        sequence="4"
        groups="account.group_account_manager"/>

    <menuitem
        id="menu_reema_accounting_contractors_list"
        name="Contractors"
        parent="menu_reema_accounting_contractors"
        action="action_reema_accounting_contractors"
        sequence="10"
        groups="account.group_account_manager"/>

</odoo>
