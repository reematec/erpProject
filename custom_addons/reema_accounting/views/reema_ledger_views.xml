<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Ledger Wizard form: the only thing a Ledger menu opens directly.
         Nothing is queried until Partner (+ optional dates) is picked and
         "View Ledger" is clicked — see reema_ledger_wizard.py for why a
         plain "browse everything, grouped" list was deliberately dropped. ── -->
    <record id="view_reema_ledger_wizard_form" model="ir.ui.view">
        <field name="name">reema.ledger.wizard.form</field>
        <field name="model">reema.ledger.wizard</field>
        <field name="arch" type="xml">
            <form string="Ledger">
                <field name="ledger_type" invisible="1"/>
                <group>
                    <field name="partner_id" required="ledger_type != 'employee'" invisible="ledger_type == 'employee'"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_view_ledger" string="View Ledger" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ── Ledger result list: opened by the wizard's View Ledger button,
         always pre-scoped to one partner (+ optional date range) by the
         domain the wizard builds — never opened directly with no filter. ── -->
    <record id="view_reema_ledger_line_list" model="ir.ui.view">
        <field name="name">reema.ledger.line.list</field>
        <field name="model">reema.ledger.line</field>
        <field name="arch" type="xml">
            <list string="Ledger" create="0" edit="0" delete="0" default_order="date, id">
                <field name="date" string="Date"/>
                <field name="move_id" string="Journal Entry"/>
                <field name="account_id" string="Account" optional="show"/>
                <field name="name" string="Label"/>
                <field name="ref" string="Reference" optional="hide"/>
                <field name="journal_id" string="Journal" optional="hide"/>
                <field name="debit" string="Debit (PKR)" widget="monetary" sum="Total Debit"/>
                <field name="credit" string="Credit (PKR)" widget="monetary" sum="Total Credit"/>
                <field name="running_balance" string="Balance (PKR)" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="partner_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ── Customer Ledger ────────────────────────────────────────────── -->
    <record id="action_customer_ledger" model="ir.actions.act_window">
        <field name="name">Customer Ledger</field>
        <field name="res_model">reema.ledger.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <!-- Explicitly reset domain/view_ids — this action id previously
             pointed at reema.ledger.line directly (before the wizard-gated
             redesign); a plain re-write of this record does NOT clear
             fields simply omitted from the new XML (Odoo upgrades are
             additive), so the old domain and old list-view binding would
             otherwise silently survive and get applied against the wrong
             model on load. -->
        <field name="domain">[]</field>
        <field name="view_ids" eval="[(5, 0, 0)]"/>
        <field name="context">{'default_ledger_type': 'customer'}</field>
    </record>
    <menuitem
        id="menu_customer_ledger"
        name="Customer Ledger"
        parent="account.menu_finance_receivables"
        action="action_customer_ledger"
        sequence="15"
        groups="account.group_account_manager"/>

    <!-- ── Customer Balances: flat summary, one row per customer's individual
         1-1-2-xx receivable account, all customers on one screen (unlike
         the Customer Ledger above, which is single-customer drill-down
         gated behind the wizard). See reema_customer_balance.py. ── -->
    <record id="view_reema_customer_balance_list" model="ir.ui.view">
        <field name="name">reema.customer.balance.list</field>
        <field name="model">reema.customer.balance</field>
        <field name="arch" type="xml">
            <list string="Customer Balances" create="0" edit="0" delete="0" default_order="account_code">
                <header>
                    <button name="action_print_customer_balance" type="object" string="Print"
                            class="btn-secondary" display="always"/>
                    <button name="action_print_customer_balance" type="object" string="Print (Skip Zero)"
                            class="btn-secondary" display="always"
                            context="{'reema_hide_zero_balance': True}"/>
                </header>
                <field name="account_code" string="Account"/>
                <field name="partner_id" string="Customer"/>
                <field name="debit" string="Debit (PKR)" widget="monetary" sum="Total Debit"/>
                <field name="credit" string="Credit (PKR)" widget="monetary" sum="Total Credit"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_reema_customer_balance_search" model="ir.ui.view">
        <field name="name">reema.customer.balance.search</field>
        <field name="model">reema.customer.balance</field>
        <field name="arch" type="xml">
            <search string="Customer Balances">
                <field name="partner_id"/>
                <filter name="hide_zero_balance" string="Non-zero Balance" domain="[('balance', '!=', 0)]"/>
            </search>
        </field>
    </record>

    <record id="action_customer_balance" model="ir.actions.act_window">
        <field name="name">Customer Balances</field>
        <field name="res_model">reema.customer.balance</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_reema_customer_balance_list"/>
        <field name="search_view_id" ref="view_reema_customer_balance_search"/>
        <field name="context">{'search_default_hide_zero_balance': 1}</field>
    </record>
    <menuitem
        id="menu_customer_balance"
        name="Customer Balances"
        parent="account.menu_finance_receivables"
        action="action_customer_balance"
        sequence="14"
        groups="account.group_account_manager"/>

    <!-- ── Vendor Ledger ──────────────────────────────────────────────── -->
    <record id="action_vendor_ledger" model="ir.actions.act_window">
        <field name="name">Vendor Ledger</field>
        <field name="res_model">reema.ledger.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <!-- Explicitly reset domain/view_ids — this action id previously
             pointed at reema.ledger.line directly (before the wizard-gated
             redesign); a plain re-write of this record does NOT clear
             fields simply omitted from the new XML (Odoo upgrades are
             additive), so the old domain and old list-view binding would
             otherwise silently survive and get applied against the wrong
             model on load. -->
        <field name="domain">[]</field>
        <field name="view_ids" eval="[(5, 0, 0)]"/>
        <field name="context">{'default_ledger_type': 'vendor'}</field>
    </record>
    <menuitem
        id="menu_vendor_ledger"
        name="Vendor Ledger"
        parent="account.menu_finance_payables"
        action="action_vendor_ledger"
        sequence="15"
        groups="account.group_account_manager"/>

    <!-- ── Vendor Balances: flat summary, one row per vendor's individual
         2-1-1-xx payable account, all vendors on one screen (unlike the
         Vendor Ledger above, which is single-vendor transaction drill-down
         gated behind the wizard). See reema_vendor_balance.py. ── -->
    <record id="view_reema_vendor_balance_list" model="ir.ui.view">
        <field name="name">reema.vendor.balance.list</field>
        <field name="model">reema.vendor.balance</field>
        <field name="arch" type="xml">
            <list string="Vendor Balances" create="0" edit="0" delete="0" default_order="account_code">
                <header>
                    <button name="action_print_vendor_balance" type="object" string="Print"
                            class="btn-secondary" display="always"/>
                    <button name="action_print_vendor_balance" type="object" string="Print (Skip Zero)"
                            class="btn-secondary" display="always"
                            context="{'reema_hide_zero_balance': True}"/>
                </header>
                <field name="account_code" string="Account"/>
                <field name="partner_id" string="Vendor"/>
                <field name="debit" string="Debit (PKR)" widget="monetary" sum="Total Debit"/>
                <field name="credit" string="Credit (PKR)" widget="monetary" sum="Total Credit"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_reema_vendor_balance_search" model="ir.ui.view">
        <field name="name">reema.vendor.balance.search</field>
        <field name="model">reema.vendor.balance</field>
        <field name="arch" type="xml">
            <search string="Vendor Balances">
                <field name="partner_id"/>
                <filter name="hide_zero_balance" string="Non-zero Balance" domain="[('balance', '!=', 0)]"/>
            </search>
        </field>
    </record>

    <record id="action_vendor_balance" model="ir.actions.act_window">
        <field name="name">Vendor Balances</field>
        <field name="res_model">reema.vendor.balance</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_reema_vendor_balance_list"/>
        <field name="search_view_id" ref="view_reema_vendor_balance_search"/>
        <field name="context">{'search_default_hide_zero_balance': 1}</field>
    </record>
    <menuitem
        id="menu_vendor_balance"
        name="Vendor Balances"
        parent="account.menu_finance_payables"
        action="action_vendor_balance"
        sequence="14"
        groups="account.group_account_manager"/>

    <!-- ── Contractor Ledger: one partner_id domain covers both the shared
         Contractors Payable account and their own advance account — see
         reema_ledger_line.py for how partner_id is derived on each. ── -->
    <record id="action_contractor_ledger" model="ir.actions.act_window">
        <field name="name">Contractor Ledger</field>
        <field name="res_model">reema.ledger.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <!-- Explicitly reset domain/view_ids — this action id previously
             pointed at reema.ledger.line directly (before the wizard-gated
             redesign); a plain re-write of this record does NOT clear
             fields simply omitted from the new XML (Odoo upgrades are
             additive), so the old domain and old list-view binding would
             otherwise silently survive and get applied against the wrong
             model on load. -->
        <field name="domain">[]</field>
        <field name="view_ids" eval="[(5, 0, 0)]"/>
        <field name="context">{'default_ledger_type': 'contractor'}</field>
    </record>
    <menuitem
        id="menu_contractor_ledger"
        name="Contractor Ledger"
        parent="menu_reema_accounting_contractors"
        action="action_contractor_ledger"
        sequence="4"
        groups="account.group_account_manager"/>

    <!-- ── Contractor Balances: flat summary, one row per contractor's
         individual 1-1-3-xx advance account (unlike the Contractor Ledger
         above, which is single-contractor transaction drill-down gated
         behind the wizard). Deliberately excludes the shared Contractors
         Payable account (2-1-2-01) — see reema_contractor_balance.py. ── -->
    <record id="view_reema_contractor_balance_list" model="ir.ui.view">
        <field name="name">reema.contractor.balance.list</field>
        <field name="model">reema.contractor.balance</field>
        <field name="arch" type="xml">
            <list string="Contractor Balances" create="0" edit="0" delete="0" default_order="account_code">
