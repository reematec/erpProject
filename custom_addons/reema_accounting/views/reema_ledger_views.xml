    <record id="action_contractor_balance" model="ir.actions.act_window">
        <field name="name">Contractor Balances</field>
        <field name="res_model">reema.contractor.balance</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_reema_contractor_balance_list"/>
        <field name="search_view_id" ref="view_reema_contractor_balance_search"/>
        <field name="context">{'search_default_hide_zero_balance': 1}</field>
    </record>
    <menuitem
        id="menu_contractor_balance"
        name="Contractor Balances"
        parent="menu_reema_accounting_contractors"
        action="action_contractor_balance"
        sequence="5"
        groups="account.group_account_manager"/>

</odoo>
