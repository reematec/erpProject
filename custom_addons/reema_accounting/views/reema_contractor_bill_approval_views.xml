<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── List View ──────────────────────────────────────────────────── -->
    <record id="view_contractor_bill_approval_list" model="ir.ui.view">
        <field name="name">reema.contractor.bill.approval.list</field>
        <field name="model">reema.contractor.bill.approval</field>
        <field name="arch" type="xml">
            <list string="Contractor Bills" create="0" edit="0" delete="0">
                <field name="name" string="Reference"/>
                <field name="partner_id" string="Contractor"
                       options="{'no_open': True}"/>
                <field name="invoice_date" string="Date"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount_total" string="Total (PKR)"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
                <field name="reema_total_deductions" string="Deductions (PKR)"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"
                       optional="hide"/>
                <field name="reema_net_payable" string="Net Payable (PKR)"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
                <field name="reema_bill_state" string="Approval"
                       widget="badge"
                       decoration-warning="reema_bill_state == 'pending'"
                       decoration-success="reema_bill_state == 'confirmed'"/>
                <field name="state" string="Status"
                       widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'posted'"
                       decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <!-- ── Form View ──────────────────────────────────────────────────── -->
    <record id="view_contractor_bill_approval_form" model="ir.ui.view">
        <field name="name">reema.contractor.bill.approval.form</field>
        <field name="model">reema.contractor.bill.approval</field>
        <field name="arch" type="xml">
            <form string="Contractor Bill" create="0" edit="0" delete="0" duplicate="0">
                <header>
                    <button name="action_approve"
                            string="Approve"
                            type="object"
                            class="btn-primary"
                            invisible="reema_bill_state == 'confirmed' or state != 'draft' or not batch_entry_ids"
                            confirm="Approve this bill as correct and ready for posting by accounting?"
                            confirm-label="Yes, Approve"
                            cancel-label="Go Back"/>
                    <button name="action_void"
                            string="Void Approval"
                            type="object"
                            invisible="reema_bill_state != 'confirmed' or state != 'draft'"
                            confirm="Void this approval? The bill will return to pending and cannot be posted until re-approved."
                            confirm-label="Yes, Void Approval"
                            cancel-label="Go Back"/>
                    <button name="action_delete"
                            string="Delete Bill"
                            type="object"
                            class="btn-danger"
                            invisible="state != 'draft'"
                            confirm="Delete this bill? All batch entries will be released back to unbilled."
                            confirm-label="Yes, Delete Bill"
                            cancel-label="Go Back"/>
                    <field name="reema_bill_state"
                           widget="statusbar"
                           statusbar_visible="pending,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"
                                   string="Contractor"
                                   readonly="1"
                                   options="{'no_open': True, 'no_create': True, 'no_edit': True}"/>
                            <field name="invoice_date" string="Invoice Date" readonly="1"/>
                        </group>
                        <group>
                            <field name="state"
                                   string="Status"
                                   widget="badge"
                                   decoration-warning="state == 'draft'"
                                   decoration-success="state == 'posted'"
                                   decoration-danger="state == 'cancel'"
                                   readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount_total"
                                   string="Total Amount (PKR)"
                                   widget="monetary"
                                   readonly="1"/>
                            <field name="reema_total_deductions"
                                   string="Advance Deductions (PKR)"
                                   widget="monetary"
                                   readonly="1"
                                   invisible="not reema_total_deductions"/>
                            <field name="reema_net_payable"
                                   string="Net Payable (PKR)"
                                   widget="monetary"
                                   readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Bill Lines" name="bill_lines_tab">
                            <field name="batch_entry_ids" readonly="1" nolabel="1">
                                <list string="Bill Lines" create="0" edit="0" delete="0">
                                    <field name="process_name" string="Process"/>
                                    <field name="mo_id" string="MO"
                                           options="{'no_open': True}"/>
                                    <field name="reema_po_id" string="PO"
                                           options="{'no_open': True}"/>
                                    <field name="qty" string="Qty"/>
                                    <field name="piece_rate_value" string="Rate (PKR)"/>
                                    <field name="amount_earned" string="Amount (PKR)"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes_tab"
                              invisible="not narration">
                            <field name="narration" readonly="1" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Search View ────────────────────────────────────────────────── -->
    <record id="view_contractor_bill_approval_search" model="ir.ui.view">
        <field name="name">reema.contractor.bill.approval.search</field>
        <field name="model">reema.contractor.bill.approval</field>
        <field name="arch" type="xml">
            <search string="Contractor Bills">
                <field name="partner_id" string="Contractor"/>
                <field name="name" string="Reference"/>
            </search>
        </field>
    </record>

    <!-- ── Window Action ──────────────────────────────────────────────── -->
    <record id="action_contractor_bill_approval" model="ir.actions.act_window">
        <field name="name">Contractor Bills</field>
        <field name="res_model">reema.contractor.bill.approval</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_draft': 1}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_contractor_bill_approval_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_contractor_bill_approval_form')})]"/>
    </record>

</odoo>
