<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Cash/Bank Voucher list: preview-only for now (create="0") — a single
         filtered view of everything posted through a cash or bank journal,
         whatever generated it (plain journal entry, Contractor Advance,
         Contractor Bill payment, regular Payment). Shared between both
         actions below; only the domain differs. ── -->
    <record id="view_cash_bank_voucher_list" model="ir.ui.view">
        <field name="name">reema.account.move.voucher.list</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="Vouchers" create="0" delete="0" default_order="date desc, name desc">
                <field name="date" string="Date"/>
                <field name="name" string="Voucher No."/>
                <field name="partner_id" string="Partner" optional="show"/>
                <field name="ref" string="Reference" optional="show"/>
                <field name="reema_voucher_amount" string="Amount (PKR)" widget="monetary" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" string="Status" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'posted'"
                       decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_cash_bank_voucher_search" model="ir.ui.view">
        <field name="name">reema.account.move.voucher.search</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <search string="Vouchers">
                <field name="name" string="Voucher No."/>
                <field name="partner_id" string="Partner"/>
                <field name="ref" string="Reference"/>
                <filter string="Posted" name="filter_posted" domain="[('state', '=', 'posted')]"/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <group expand="0" string="Group By">
                    <filter string="Partner" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Month" name="group_month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cash_vouchers" model="ir.actions.act_window">
        <field name="name">Cash Vouchers</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('journal_id.type', '=', 'cash')]</field>
        <field name="context">{'search_default_filter_posted': 1}</field>
        <field name="search_view_id" ref="view_cash_bank_voucher_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_cash_bank_voucher_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('account.view_move_form')})]"/>
    </record>
    <menuitem
        id="menu_cash_vouchers"
        name="Cash Vouchers"
        parent="account.menu_finance_entries"
        action="action_cash_vouchers"
        sequence="2"
        groups="account.group_account_manager"/>

    <record id="action_bank_vouchers" model="ir.actions.act_window">
        <field name="name">Bank Vouchers</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('journal_id.type', '=', 'bank')]</field>
        <field name="context">{'search_default_filter_posted': 1}</field>
        <field name="search_view_id" ref="view_cash_bank_voucher_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_cash_bank_voucher_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('account.view_move_form')})]"/>
    </record>
    <menuitem
        id="menu_bank_vouchers"
        name="Bank Vouchers"
        parent="account.menu_finance_entries"
        action="action_bank_vouchers"
        sequence="3"
        groups="account.group_account_manager"/>

</odoo>
