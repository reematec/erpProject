<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ir_model_chatter_list" model="ir.ui.view">
        <field name="name">ir.model.chatter.layout.list</field>
        <field name="model">ir.model</field>
        <field name="arch" type="xml">
            <list string="Chatter Layout" js_class="reema_chatter_layout_list" editable="bottom" create="0" delete="0" default_order="name">
                <field name="name" string="Document" optional="show"/>
                <field name="model" string="Technical Name" optional="hide"/>
                <field name="reema_bottom_chatter" string="Bottom Chatter" optional="show" class="o_reema_bottom_chatter_cell"/>
            </list>
        </field>
    </record>

    <record id="action_ir_model_chatter_layout" model="ir.actions.act_window">
        <field name="name">Chatter Layout</field>
        <field name="res_model">ir.model</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_ir_model_chatter_list"/>
        <field name="domain">[('is_mail_thread', '=', True), ('transient', '=', False)]</field>
    </record>

    <menuitem id="menu_ir_model_chatter_layout"
              name="Chatter Layout"
              action="action_ir_model_chatter_layout"
              parent="base.next_id_9"
              sequence="60"/>

</odoo>
