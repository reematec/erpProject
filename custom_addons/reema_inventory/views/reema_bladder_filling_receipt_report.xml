<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_bladder_filling_receipt_slip">
        <t t-call="web.html_container">
            <style>
                @media print {
                    .bfr_doc { page-break-after: always; }
                    .bfr_doc:last-child { page-break-after: auto; }
                }
                @page { margin: 12mm; }
            </style>
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page bfr_doc">

                        <!-- Title -->
                        <div class="row mt-2 mb-2">
                            <div class="col-12">
                                <div style="font-size:15px; font-weight:700; margin-bottom:1px;">
                                    <span t-field="doc.name"/>
                                    <br/>
                                    <span t-field="doc.vendor_id"/>
                                </div>
                            </div>
                        </div>

                        <hr style="margin-top:4px;"/>

                        <!-- Header details -->
                        <div class="row mt-3">
                            <div class="col-6">
                                <table class="table table-sm table-borderless" style="font-size:13px;">
                                    <tr>
                                        <td style="width:45%;"><strong>Receipt Date</strong></td>
                                        <td><span t-field="doc.date"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Issue</strong></td>
                                        <td><t t-esc="doc.issue_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Manufacturing Order</strong></td>
                                        <td><t t-esc="doc.mo_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Filling Vendor</strong></td>
                                        <td><t t-esc="doc.vendor_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Vendor Pass No.</strong></td>
                                        <td><t t-esc="doc.vendor_pass_number or '-'"/></td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-6">
                                <table class="table table-sm table-borderless" style="font-size:13px;">
                                    <tr>
                                        <td style="width:45%;"><strong>Bladder Account</strong></td>
                                        <td><t t-esc="doc.account_id.display_name"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Filled Bladder Account</strong></td>
                                        <td><t t-esc="doc.filled_account_id.display_name or '-'"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Filling Weight</strong></td>
                                        <td><t t-out="('%.2f' % doc.filling_weight).rstrip('0').rstrip('.')"/> g</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Rate / Bladder</strong></td>
                                        <td>PKR <t t-out="('%.2f' % doc.rate)"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <h5 class="mt-3 mb-1">Quantities</h5>
                        <table class="table table-sm table-striped" style="font-size:12px;">
                            <thead>
                                <tr class="table-dark">
                                    <th>Filled (Payable)</th>
                                    <th>Damaged (Returned Unfilled)</th>
                                    <th>Lost (Not Returned)</th>
                                    <th class="text-end">Rate (PKR)</th>
                                    <th class="text-end">Amount (PKR)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><span t-field="doc.qty_filled"/></td>
                                    <td><span t-field="doc.qty_damaged"/></td>
                                    <td><span t-field="doc.qty_lost"/></td>
                                    <td class="text-end"><t t-out="('%.2f' % doc.rate)"/></td>
                                    <td class="text-end"><t t-out="('%.2f' % doc.amount)"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <p style="font-size:12px;" class="mt-2" t-if="doc.notes">
                            <strong>Notes:</strong> <span t-field="doc.notes"/>
                        </p>

                        <!-- Signatures -->
                        <div class="row mt-5">
                            <div class="col-6 text-center">
                                <div style="border-top:1px solid #000; padding-top:4px; font-size:12px;">
                                    Received By (Store Keeper)
                                </div>
                            </div>
                            <div class="col-6 text-center">
                                <div style="border-top:1px solid #000; padding-top:4px; font-size:12px;">
                                    Vendor / Driver
                                </div>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_bladder_filling_receipt" model="ir.actions.report">
        <field name="name">Bladder Filling Receipt Slip</field>
        <field name="model">reema.bladder.filling.receipt</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">reema_inventory.report_bladder_filling_receipt_slip</field>
        <field name="report_file">reema_inventory.report_bladder_filling_receipt_slip</field>
        <field name="print_report_name">'Bladder Filling Receipt - %s' % (object.name)</field>
    </record>
</odoo>
