<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_reema_hr_attendance_generate_wizard_form" model="ir.ui.view">
        <field name="name">reema.hr.attendance.generate.wizard.form</field>
        <field name="model">reema.hr.attendance.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Attendance">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <p class="text-muted">
                    Applies to every employee active during this period (by Joining/Departure Date).
                    Days matching the company's Weekly Off Day or a Public Holiday are created as
                    Holiday automatically — everyone else is created Present at the standard check-in time.
                </p>
                <footer>
                    <button string="Generate" type="object" name="action_generate" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_reema_hr_attendance_generate_wizard" model="ir.actions.act_window">
        <field name="name">Generate Attendance</field>
        <field name="res_model">reema.hr.attendance.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_reema_hr_attendance_list" model="ir.ui.view">
        <field name="name">reema.hr.attendance.list</field>
        <field name="model">reema.hr.attendance</field>
        <field name="arch" type="xml">
            <list string="Attendance" editable="bottom" create="0" class="o_reema_hr_attendance_list"
                  js_class="reema_hr_attendance_list"
                  decoration-danger="state == 'absent'" decoration-warning="state == 'holiday'"
                  decoration-muted="payroll_locked">
                <header>
                    <button name="%(action_reema_hr_attendance_generate_wizard)d" string="Generate Attendance"
                            type="action" class="btn-secondary" display="always"/>
                    <button name="action_mark_holiday" string="Mark as Holiday"
                            type="object" class="btn-primary"/>
                    <button name="action_mark_present" string="Mark as Present"
                            type="object" class="btn-secondary"/>
                </header>
                <field name="employee_id" readonly="1"/>
                <field name="date" readonly="1"/>
                <field name="payroll_locked" invisible="1"/>
                <field name="state" readonly="payroll_locked"/>
                <field name="check_in" widget="float_time" optional="show" readonly="payroll_locked"/>
                <field name="half_time_out" widget="float_time" optional="show" readonly="payroll_locked"/>
                <field name="half_time_in" widget="float_time" optional="show" readonly="payroll_locked"/>
                <field name="check_out" widget="float_time" optional="show" readonly="payroll_locked"/>
                <field name="late_minutes" optional="hide" readonly="1"/>
                <field name="late_deduction" optional="hide" sum="Total" readonly="1"/>
                <field name="early_minutes" optional="hide" readonly="1"/>
                <field name="early_deduction" optional="hide" sum="Total" readonly="1"/>
                <field name="deduction_waived" optional="hide" readonly="payroll_locked"
                       groups="reema_hr.group_reema_hr_manager"/>
            </list>
        </field>
    </record>

    <record id="view_reema_hr_attendance_form" model="ir.ui.view">
        <field name="name">reema.hr.attendance.form</field>
        <field name="model">reema.hr.attendance</field>
        <field name="arch" type="xml">
            <form string="Attendance">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id" readonly="1" context="{'active_test': False}"
                                   options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                            <field name="date" readonly="1"/>
                            <field name="payroll_locked" invisible="1"/>
                            <field name="state" readonly="payroll_locked"/>
                        </group>
                        <group>
                            <field name="check_in" widget="float_time" readonly="payroll_locked"/>
                            <field name="half_time_out" widget="float_time" readonly="payroll_locked"/>
                            <field name="half_time_in" widget="float_time" readonly="payroll_locked"/>
                            <field name="check_out" widget="float_time" readonly="payroll_locked"/>
                        </group>
                        <group string="Deductions" groups="reema_hr.group_reema_hr_manager">
                            <field name="late_minutes"/>
                            <field name="late_deduction"/>
                            <field name="early_minutes"/>
                            <field name="early_deduction"/>
                            <field name="deduction_waived" readonly="payroll_locked"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_reema_hr_attendance_search" model="ir.ui.view">
        <field name="name">reema.hr.attendance.search</field>
        <field name="model">reema.hr.attendance</field>
        <field name="arch" type="xml">
            <search string="Attendance">
                <field name="employee_id"/>
                <field name="date"/>
                <filter string="Present" name="filter_present" domain="[('state', '=', 'present')]"/>
                <filter string="Absent" name="filter_absent" domain="[('state', '=', 'absent')]"/>
                <filter string="Holiday" name="filter_holiday" domain="[('state', '=', 'holiday')]"/>
                <filter string="Late" name="filter_late" domain="[('late_minutes', '>', 0)]"/>
                <separator/>
                <filter string="This Month" name="filter_this_month"
                        domain="[('date', '>=', context_today().strftime('%Y-%m-01'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_reema_hr_attendance" model="ir.actions.act_window">
        <field name="name">Attendance</field>
        <field name="res_model">reema.hr.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_this_month': 1, 'search_default_group_employee': 1}</field>
    </record>

</odoo>
