<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_reema_hr_payslip_generate_wizard_form" model="ir.ui.view">
        <field name="name">reema.hr.payslip.generate.wizard.form</field>
        <field name="model">reema.hr.payslip.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Payslips">
                <group>
                    <field name="period_month"/>
                    <field name="period_year" options="{'enable_formatting': False}"/>
                </group>
                <p class="text-muted">
                    Applies to every employee active during this month (by Joining/Departure Date).
                    A draft payslip is created for each one (skipping anyone who already has one for
                    this month), computed from their attendance for these dates.
                </p>
                <footer>
                    <button string="Generate" type="object" name="action_generate" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_reema_hr_payslip_generate_wizard" model="ir.actions.act_window">
        <field name="name">Generate Payslips</field>
        <field name="res_model">reema.hr.payslip.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_reema_hr_payslip_list" model="ir.ui.view">
        <field name="name">reema.hr.payslip.list</field>
        <field name="model">reema.hr.payslip</field>
        <field name="arch" type="xml">
            <list string="Payslips" js_class="reema_hr_payslip_list">
                <header>
                    <button name="%(action_reema_hr_payslip_generate_wizard)d" string="Generate Payslips"
                            type="action" class="btn-secondary" display="always"
                            groups="reema_hr.group_reema_hr_user"/>
                    <!-- Segregation of duties: HR prepares/confirms salaries, only Accounts
                         staff can trigger the actual payment — see action_pay's own access
                         check in reema_hr_payslip.py, this is just the matching UI gate. -->
                    <button name="action_open_pay_wizard" string="Pay Selected"
                            type="object" class="btn-primary"
                            groups="reema_accounting.group_reema_accountant"/>
                    <!-- Print is rendered by payslip_month_filter_list.js/.xml instead of a
                         plain type="object" button — it needs to read which columns are
                         currently visible on screen before printing. -->
                </header>
                <field name="name" string="Payslip No." optional="show"/>
                <field name="employee_id" optional="show"/>
                <field name="period_month" optional="show"/>
                <field name="period_year" options="{'enable_formatting': False}" optional="show"/>
                <field name="monthly_salary" optional="show"/>
                <field name="absent_deduction" optional="show"/>
                <field name="half_day_deduction" optional="show"/>
                <field name="gross_pay" optional="show"/>
                <field name="late_deduction" optional="show"/>
                <field name="early_leave_deduction" optional="hide"/>
                <field name="advance_deduction" optional="show"/>
                <field name="loan_deduction" optional="show"/>
                <field name="eobi_deduction" optional="show"/>
                <field name="pessi_deduction" optional="show"/>
                <field name="net_pay" sum="Total" optional="show"/>
                <field name="state" widget="badge" optional="show"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'confirmed'"
                       decoration-success="state == 'paid'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_reema_hr_payslip_form" model="ir.ui.view">
        <field name="name">reema.hr.payslip.form</field>
        <field name="model">reema.hr.payslip</field>
        <field name="arch" type="xml">
            <form string="Payslip">
                <header>
                    <!-- Segregation of duties: preparing/confirming a payslip is HR's job;
                         paying it is Accounts' job (see action_pay's own access check) — kept
                         as two mutually-exclusive button groups rather than one shared set. -->
                    <button name="action_recompute" string="Recompute" type="object"
                            class="o_reema_hr_save_first" groups="reema_hr.group_reema_hr_user"
                            invisible="state != 'draft' or not id"/>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="btn-primary o_reema_hr_save_first" groups="reema_hr.group_reema_hr_user"
                            invisible="state != 'draft'"
                            confirm="Confirm this payslip? Attendance-based pay and outstanding advances/loans will be locked in and a journal entry posted."
                            confirm-label="Yes, Confirm" cancel-label="Go Back"/>
                    <button name="action_open_pay_wizard" string="Pay" type="object"
                            class="btn-primary o_reema_hr_save_first" groups="reema_accounting.group_reema_accountant"
                            invisible="state != 'confirmed'"/>
                    <button name="action_cancel" string="Cancel Payslip" type="object"
                            class="o_reema_hr_save_first" groups="reema_hr.group_reema_hr_user"
                            invisible="state not in ('draft', 'confirmed') or not id"
                            confirm="Cancel this payslip? Any recovered advances/loan installments will be released back to pending."
                            confirm-label="Yes, Cancel" cancel-label="Go Back"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                            class="o_reema_hr_save_first" groups="reema_hr.group_reema_hr_user"
                            invisible="state != 'cancelled'"/>
                    <button name="action_print_payslip" string="Print" type="object"
                            class="btn-secondary" invisible="not id"/>
                    <!-- Pure static HTML, not an Odoo <button> — deliberately not routed
                         through the form controller's button pipeline, which saves the
                         record before running ANY header button (per Odoo's
                         form_controller.js beforeExecuteActionButton). This is a plain
                         read-only reference popup with no relation to the record's data,
                         so it must never save anything, even implicitly. Bootstrap's
                         dropdown JS is already bundled and globally active in
                         web.assets_backend, so data-bs-toggle="dropdown" works with zero
                         custom JS and zero server round-trip. Mirrors
                         reema_accounting/views/reema_contractor_advance_views.xml. -->
                    <div class="dropdown d-inline-block align-middle" groups="base.group_user">
                        <a href="#" class="btn btn-link p-1" data-bs-toggle="dropdown"
                           aria-expanded="false" title="Status &amp; calculation reference"
                           style="text-decoration:none;">
                            <i class="fa fa-info-circle" style="font-size:16px;"/>
                        </a>
                        <div class="dropdown-menu p-3" style="width:640px; max-width:90vw;">
                            <table class="table table-sm table-bordered" style="font-size:13px;">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:110px">Status</th>
                                        <th>What it means</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><span class="badge text-bg-info">Draft</span></td>
                                        <td>Editable — recomputes live from attendance whenever you change the employee, period, or a waiver. Nothing posted yet.</td>
                                    </tr>
                                    <tr>
                                        <td><span class="badge text-bg-warning">Confirmed</span></td>
                                        <td>Pay and outstanding advance/loan recovery are locked in. The accrual journal entry is posted (Dr Salary Expense / Cr Salaries Payable + Advance-Loan + EOBI/PESSI Payable). This employee's attendance for the period becomes locked — no create/edit/delete until this payslip is cancelled.</td>
                                    </tr>
                                    <tr>
                                        <td><span class="badge text-bg-success">Paid</span></td>
                                        <td>The payment journal entry is posted (Dr Salaries Payable / Cr Bank-Cash). Final state — cannot be cancelled; reverse the payment entry manually if a correction is genuinely needed.</td>
                                    </tr>
                                    <tr>
                                        <td><span class="badge text-bg-danger">Cancelled</span></td>
                                        <td>Accrual entry reversed (if one existed), recovered advance/loan lines released back to Due, attendance unlocked again.</td>
                                    </tr>
                                </tbody>
                            </table>
                            <table class="table table-sm table-bordered mt-2" style="font-size:13px;">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:130px">Button</th>
                                        <th style="width:110px">Available when</th>
                                        <th>What it does</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><strong>Recompute</strong></td>
                                        <td>Draft</td>
                                        <td>Re-pulls attendance and refreshes all pay fields — same math as the live draft preview, just explicit.</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Confirm</strong></td>
                                        <td>Draft</td>
                                        <td>Freezes the numbers, posts the accrual entry, marks recovered advance/loan lines Paid, locks this period's attendance.</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Pay</strong></td>
                                        <td>Confirmed</td>
                                        <td>Opens a payment-method wizard and posts the payment entry, moving status to Paid.</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Cancel Payslip</strong></td>
                                        <td>Draft / Confirmed</td>
                                        <td>Reverses the accrual entry (if posted), releases recovered advances/loans back to Due, unlocks attendance.</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Reset to Draft</strong></td>
                                        <td>Cancelled</td>
                                        <td>Brings it back to Draft, clearing statutory/advance/loan deduction totals, ready to recompute.</td>
                                    </tr>
                                </tbody>
                            </table>
                            <table class="table table-sm table-bordered mt-2 mb-0" style="font-size:13px;">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:170px">Field</th>
                                        <th>How it's calculated</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><strong>Daily Rate</strong></td>
                                        <td>Monthly Salary ÷ Working Days (calendar days minus the company's weekly-off day and public holidays for this month).</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Gross Pay</strong></td>
                                        <td>Daily Rate × (Present + Leave + Absent Waived + Half Waived + 0.5 × (Half − Half Waived)). Leave is always fully paid; Absent is unpaid unless waived; Half Day pays 50% unless waived (then paid in full).</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Late / Early Leave Deduction</strong></td>
                                        <td>Per-minute rate (Daily Rate ÷ Hours per Day ÷ 60) × late/early minutes. Grace period is all-or-nothing — arriving within grace deducts nothing; even one minute past grace deducts the full duration, grace minutes included. Waivable per-day on Attendance or for the whole month here.</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Advance / Loan Deduction</strong></td>
                                        <td>Oldest-due-first recovery from this employee's posted vouchers dated on or before this payslip's period, capped so Net Pay never goes negative. A waived category is skipped and rolls forward to the next payslip.</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Net Pay</strong></td>
                                        <td>Net Salary Expense (Gross Pay minus Late/Early deductions) minus Advance, Loan, EOBI and PESSI deductions.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"
                                   context="{'active_test': False}"
                                   options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                            <field name="period_month" readonly="state != 'draft'"/>
                            <field name="period_year" readonly="state != 'draft'" options="{'enable_formatting': False}"/>
                            <field name="monthly_salary" readonly="1"/>
                            <field name="daily_rate" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_days" readonly="1"/>
                            <field name="holiday_days" readonly="1"/>
                            <field name="working_days" readonly="1"/>
                            <label for="absent_days"/>
                            <div class="d-flex align-items-center gap-3">
                                <field name="absent_days" readonly="1"/>
                                <field name="absent_waived_days" readonly="state != 'draft'"
                                       groups="reema_hr.group_reema_hr_manager"/>
                                <span class="text-muted" groups="reema_hr.group_reema_hr_manager">Waived</span>
                            </div>
                            <field name="leave_days" readonly="1"/>
                            <label for="half_days"/>
                            <div class="d-flex align-items-center gap-3">
                                <field name="half_days" readonly="1"/>
                                <field name="half_waived_days" readonly="state != 'draft'"
                                       groups="reema_hr.group_reema_hr_manager"/>
                                <span class="text-muted" groups="reema_hr.group_reema_hr_manager">Waived</span>
                            </div>
                            <field name="present_days" readonly="1"/>
                            <label for="late_minutes"/>
                            <div class="d-flex align-items-center gap-3">
                                <field name="late_minutes" readonly="1"/>
                                <field name="late_deduction_waived" readonly="state != 'draft'"
                                       groups="reema_hr.group_reema_hr_manager"/>
                                <span class="text-muted" groups="reema_hr.group_reema_hr_manager">Waive</span>
                            </div>
                            <label for="early_minutes"/>
                            <div class="d-flex align-items-center gap-3">
                                <field name="early_minutes" readonly="1"/>
                                <field name="early_leave_deduction_waived" readonly="state != 'draft'"
                                       groups="reema_hr.group_reema_hr_manager"/>
                                <span class="text-muted" groups="reema_hr.group_reema_hr_manager">Waive</span>
                            </div>
                        </group>
                    </group>
                    <group>
                        <group string="Pay">
                            <field name="absent_deduction" readonly="1"/>
                            <field name="half_day_deduction" readonly="1"/>
                            <field name="gross_pay" readonly="1"/>
                            <field name="late_deduction" readonly="1"/>
                            <field name="early_leave_deduction" readonly="1"/>
                            <field name="net_salary_expense" readonly="1"/>
                        </group>
                        <group string="Deductions">
                            <label for="advance_deduction"/>
                            <div class="d-flex align-items-center gap-3">
                                <field name="advance_deduction" readonly="1"/>
                                <field name="advance_deduction_waived" readonly="state != 'draft'"
                                       groups="reema_hr.group_reema_hr_manager"/>
                                <span class="text-muted" groups="reema_hr.group_reema_hr_manager">Waive</span>
                            </div>
                            <label for="loan_deduction"/>
                            <div class="d-flex align-items-center gap-3">
                                <field name="loan_deduction" readonly="1"/>
                                <field name="loan_deduction_waived" readonly="state != 'draft'"
                                       groups="reema_hr.group_reema_hr_manager"/>
                                <span class="text-muted" groups="reema_hr.group_reema_hr_manager">Waive</span>
                            </div>
                            <field name="eobi_deduction" readonly="1"/>
                            <field name="pessi_deduction" readonly="1"/>
                            <field name="net_pay" readonly="1"/>
                        </group>
                    </group>
                    <notebook invisible="state == 'draft'">
                        <page string="Recovered Advances/Loans" invisible="not advance_loan_line_recovered_ids">
                            <field name="advance_loan_line_recovered_ids" readonly="1">
                                <list>
                                    <field name="advance_id"/>
                                    <field name="advance_type" widget="badge"/>
                                    <field name="sequence"/>
                                    <field name="amount"/>
                                </list>
                            </field>
                        </page>
                        <page string="Journal Entries">
                            <group>
                                <field name="move_id" readonly="1" widget="reema_hr_many2one_new_tab"/>
                                <field name="payment_move_id" readonly="1" invisible="not payment_move_id"
                                       widget="reema_hr_many2one_new_tab"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_reema_hr_payslip_search" model="ir.ui.view">
        <field name="name">reema.hr.payslip.search</field>
        <field name="model">reema.hr.payslip</field>
        <field name="arch" type="xml">
            <search string="Payslips">
                <field name="employee_id"/>
                <field name="period_month"/>
                <field name="period_year" options="{'enable_formatting': False}"/>
                <!-- Never shown in the Filters menu (invisible) — only ever applied via the
                     action's search_default_ context, so the list starts genuinely empty
                     (no fetch of every payslip ever generated) until the Month/Year picker
                     widget (payslip_month_filter_list.js) replaces it with a real scope. -->
                <filter string="No Month Selected" name="filter_no_month_selected"
                        domain="[('id', 'in', [])]" invisible="1"/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="filter_confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Paid" name="filter_paid" domain="[('state', '=', 'paid')]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Year" name="group_year" context="{'group_by': 'period_year'}"/>
                    <filter string="Month" name="group_month" context="{'group_by': 'period_month'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_reema_hr_payslip" model="ir.actions.act_window">
        <field name="name">Payslips</field>
        <field name="res_model">reema.hr.payslip</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_no_month_selected': 1}</field>
    </record>

    <record id="view_reema_hr_payslip_pay_wizard_form" model="ir.ui.view">
        <field name="name">reema.hr.payslip.pay.wizard.form</field>
        <field name="model">reema.hr.payslip.pay.wizard</field>
        <field name="arch" type="xml">
            <form string="Pay Payslips">
                <group>
                    <field name="payslip_ids" widget="many2many_tags" readonly="1"/>
                    <field name="journal_id" options="{'no_create': True, 'no_edit': True}"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="total_amount" readonly="1"/>
                </group>
                <footer>
                    <button string="Pay" type="object" name="action_confirm" class="btn-primary"
                            confirm="Post payment for the selected payslip(s)?"
                            confirm-label="Yes, Pay" cancel-label="Go Back"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
