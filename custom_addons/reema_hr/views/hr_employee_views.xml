<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_form_inherit_reema_hr" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.reema.hr</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_reema_advances" type="object" class="oe_stat_button" icon="fa-money"
                        groups="reema_hr.group_reema_hr_user">
                    <field name="reema_advance_count" widget="statinfo" string="Advances/Loans"/>
                </button>
                <button name="action_view_reema_payslips" type="object" class="oe_stat_button" icon="fa-file-text-o"
                        groups="reema_hr.group_reema_hr_user">
                    <field name="reema_payslip_count" widget="statinfo" string="Payslips"/>
                </button>
            </div>
            <group name="departure" position="before">
                <group string="Employment Dates" name="reema_hr_employment_dates" groups="hr.group_hr_user">
                    <field name="reema_join_date"/>
                </group>
                <group string="Salary &amp; Statutory Deductions" name="reema_hr_salary" groups="hr.group_hr_user">
                    <field name="monthly_salary"/>
                    <field name="has_eobi"/>
                    <field name="eobi_amount" invisible="not has_eobi" required="has_eobi"/>
                    <field name="has_pessi"/>
                    <field name="pessi_amount" invisible="not has_pessi" required="has_pessi"/>
                </group>
            </group>
        </field>
    </record>

</odoo>
