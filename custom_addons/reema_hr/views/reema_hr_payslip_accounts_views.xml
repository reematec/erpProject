<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Accounting-app entry point for Payslips, per the segregation-of-duties
        rule confirmed with the user: HR prepares and confirms salaries,
        Accounts staff trigger the actual payment. Mirrors the existing
        Contractor Bills pattern exactly (see reema_accounting's
        menu_reema_accounting_contractors / menu_contractor_bills_ready_to_pay):
        a "Payroll" menu under Accounting with a full read-only history and a
        "Ready to Pay" queue where the Pay action actually lives.

        These views/actions/menus live in reema_hr (not reema_accounting) —
        reema_accounting doesn't depend on reema_hr, so it can't reference
        reema.hr.payslip; reema_hr already depends on reema_accounting for
        the group_reema_accountant reference.

        Read-only via edit="0"/create="0"/delete="0" on the inherited
        list/form roots — Accounts can view and pay, never edit amounts or
        re-confirm/re-draft a payslip (the header buttons for those actions
        are separately restricted to reema_hr.group_reema_hr_user regardless,
        this is the second, UI-level layer so there's nothing to edit at all).
    -->

    <record id="view_reema_hr_payslip_list_readonly" model="ir.ui.view">
        <field name="name">reema.hr.payslip.list.readonly</field>
        <field name="model">reema.hr.payslip</field>
        <field name="inherit_id" ref="view_reema_hr_payslip_list"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="edit">0</attribute>
                <attribute name="create">0</attribute>
                <attribute name="delete">0</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_reema_hr_payslip_form_readonly" model="ir.ui.view">
        <field name="name">reema.hr.payslip.form.readonly</field>
        <field name="model">reema.hr.payslip</field>
        <field name="inherit_id" ref="view_reema_hr_payslip_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="edit">0</attribute>
                <attribute name="create">0</attribute>
                <attribute name="delete">0</attribute>
            </xpath>
        </field>
    </record>

    <record id="action_reema_hr_payslip_accounts" model="ir.actions.act_window">
        <field name="name">Payslips</field>
        <field name="res_model">reema.hr.payslip</field>
        <field name="view_mode">list,form</field>
        <!-- Same default scope as the HR-side Payslips screen (see
             view_reema_hr_payslip_search's filter_this_month) — starts on the
             current month instead of fetching every payslip ever generated;
             removable via the facet chip's "x" in the search bar. Ready to
             Pay (below) deliberately does NOT get this — an unpaid confirmed
             payslip from a prior month still needs to show up there. -->
        <field name="context">{'search_default_filter_this_month': 1}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_reema_hr_payslip_list_readonly')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_reema_hr_payslip_form_readonly')})]"/>
    </record>

    <record id="action_reema_hr_payslip_ready_to_pay" model="ir.actions.act_window">
        <field name="name">Payslips — Ready to Pay</field>
        <field name="res_model">reema.hr.payslip</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'confirmed')]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_reema_hr_payslip_list_readonly')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_reema_hr_payslip_form_readonly')})]"/>
    </record>

    <menuitem id="menu_reema_accounting_payroll"
              name="Payroll"
              parent="account.menu_finance"
              sequence="5"
              groups="reema_accounting.group_reema_accountant"/>

    <menuitem id="menu_reema_accounting_payroll_ready_to_pay"
              name="Ready to Pay"
              parent="menu_reema_accounting_payroll"
              action="action_reema_hr_payslip_ready_to_pay"
              sequence="10"/>

    <menuitem id="menu_reema_accounting_payroll_list"
              name="Payslips"
              parent="menu_reema_accounting_payroll"
              action="action_reema_hr_payslip_accounts"
              sequence="20"/>

    <!-- ── Employee Ledger: opens reema_accounting's shared Ledger Wizard
         (see reema_ledger_wizard.py / reema_ledger_wizard_hr.py) scoped to
         ledger_type='employee' — nothing loads until an employee (+ optional
         date range) is picked and "View Ledger" is clicked. ── -->
    <record id="view_reema_ledger_wizard_form_hr" model="ir.ui.view">
        <field name="name">reema.ledger.wizard.form.hr</field>
        <field name="model">reema.ledger.wizard</field>
        <field name="inherit_id" ref="reema_accounting.view_reema_ledger_wizard_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="employee_id" required="ledger_type == 'employee'"
                       invisible="ledger_type != 'employee'"/>
            </field>
        </field>
    </record>

    <record id="action_reema_accounting_employee_ledger" model="ir.actions.act_window">
        <field name="name">Employee Ledger</field>
        <field name="res_model">reema.ledger.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_ledger_type': 'employee'}</field>
        <!-- Reset stale domain/view_ids left over from before the
             wizard-gated redesign — see the matching comment in
             reema_accounting's reema_ledger_views.xml. -->
        <field name="domain">[]</field>
        <field name="view_ids" eval="[(5, 0, 0)]"/>
    </record>
    <menuitem id="menu_reema_accounting_employee_ledger"
              name="Employee Ledger"
              parent="menu_reema_accounting_payroll"
              action="action_reema_accounting_employee_ledger"
              sequence="30"/>

</odoo>
