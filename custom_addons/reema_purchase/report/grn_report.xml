<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="report_grn" model="ir.actions.report">
        <field name="name">Goods Receipt Note</field>
        <field name="model">reema.grn</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">reema_purchase.report_grn_template</field>
        <field name="report_file">reema_purchase.report_grn_template</field>
        <field name="print_report_name">'GRN - %s' % (object.name)</field>
    </record>

    <template id="report_grn_template">
        <t t-call="web.html_container">
            <!-- No in-page toolbar: user prints with Ctrl+P and closes the tab. -->
            <style>
                @media print {
                    .grn_doc { page-break-after: always; }
                    .grn_doc:last-child { page-break-after: auto; }
                }
                @page { margin: 12mm; }
            </style>
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page grn_doc">

                        <!-- Title: GRN reference + supplier -->
                        <div class="row mt-2 mb-2">
                            <div class="col-12">
                                <div style="font-size:15px; font-weight:700; margin-bottom:1px;">
                                    <span t-field="o.name"/> — Goods Receipt Note
                                    <br/>
                                    <span t-field="o.partner_id"/>
                                </div>
                            </div>
                        </div>

                        <hr style="margin-top:4px;"/>

                        <!-- Basic details -->
                        <div class="row mt-3">
                            <div class="col-6">
                                <table class="table table-sm table-borderless" style="font-size:13px;">
                                    <tr>
                                        <td style="width:45%;"><strong>Date</strong></td>
                                        <td><span t-field="o.date"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>PO Reference</strong></td>
                                        <td><span t-field="o.po_id"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Inward Gate Pass</strong></td>
                                        <td><span t-field="o.gate_pass_id"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Status</strong></td>
                                        <td><span t-field="o.state"/></td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-6">
                                <table class="table table-sm table-borderless" style="font-size:13px;">
                                    <tr>
                                        <td style="width:45%;"><strong>Supplier</strong></td>
                                        <td><span t-field="o.partner_id"/></td>
                                    </tr>
                                    <tr t-if="o.partner_id.city">
                                        <td><strong>City</strong></td>
                                        <td><span t-field="o.partner_id.city"/></td>
                                    </tr>
                                    <tr t-if="o.partner_id.phone">
                                        <td><strong>Tel</strong></td>
                                        <td><span t-field="o.partner_id.phone"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Received By</strong></td>
                                        <td><span t-field="o.received_by"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Line Items -->
                        <h5 class="mt-3 mb-1">Receipt Lines</h5>
                        <table class="table table-sm table-striped" style="font-size:12px;">
                            <thead>
                                <tr class="table-dark">
                                    <th>#</th>
                                    <th>Product</th>
                                    <th>Description</th>
                                    <th>Unit</th>
                                    <th class="text-end">PO Qty</th>
                                    <th class="text-end">Arrived</th>
                                    <th class="text-end">Accepted</th>
                                    <th class="text-end">Rejected</th>
                                    <th>Rejection Reason</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.line_ids" t-as="line">
                                    <tr>
                                        <td><t t-esc="line_index + 1"/></td>
                                        <td><span t-esc="line.product_id.display_name or line.product_name or '—'"/></td>
                                        <td><small><t t-esc="line.description or '—'"/></small></td>
                                        <td><span t-field="line.product_uom_id"/></td>
                                        <td class="text-end"><t t-out="('%.6f' % line.ordered_qty).rstrip('0').rstrip('.')"/></td>
                                        <td class="text-end"><t t-out="('%.6f' % line.received_qty).rstrip('0').rstrip('.')"/></td>
                                        <td class="text-end"><strong><t t-out="('%.6f' % line.accepted_qty).rstrip('0').rstrip('.')"/></strong></td>
                                        <td class="text-end"><t t-out="('%.6f' % line.rejected_qty).rstrip('0').rstrip('.')"/></td>
                                        <td><small><t t-esc="line.rejection_reason or '—'"/></small></td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot groups="reema_purchase.group_reema_purchase_manager">
                                <tr class="fw-bold">
                                    <td colspan="6" class="text-end">Total Accepted Value (PKR)</td>
                                    <td colspan="3" class="text-end"><span t-field="o.total_accepted_value"/></td>
                                </tr>
                            </tfoot>
                        </table>

                        <!-- Inspection Results -->
                        <t t-if="o.inspection_ids">
                            <h5 class="mt-3 mb-1">Inspection / QC Results</h5>
                            <table class="table table-sm table-striped" style="font-size:12px;">
                                <thead>
                                    <tr class="table-dark">
                                        <th>#</th>
                                        <th>Product</th>
                                        <th>Check</th>
                                        <th class="text-end">Sample Size</th>
                                        <th>Expected</th>
                                        <th>Actual</th>
                                        <th>Result</th>
                                        <th>Notes</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.inspection_ids" t-as="insp">
                                        <tr>
                                            <td><t t-esc="insp_index + 1"/></td>
                                            <td><span t-esc="insp.product_id.display_name or '—'"/></td>
                                            <td><span t-field="insp.check_name"/></td>
                                            <td class="text-end"><t t-esc="insp.sample_qty or '—'"/></td>
                                            <td><t t-esc="insp.expected_value or '—'"/></td>
                                            <td><t t-esc="insp.actual_value or '—'"/></td>
                                            <td><strong><t t-esc="(insp.result or '—').upper()"/></strong></td>
                                            <td><small><t t-esc="insp.notes or '—'"/></small></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <!-- Accounting entry reference (managers only) -->
                        <div t-if="o.move_id" class="mt-2" groups="reema_purchase.group_reema_purchase_manager">
                            <small class="text-muted">
                                Interim Journal Entry: <span t-field="o.move_id"/>
                            </small>
                        </div>

                        <!-- Signatures -->
                        <div class="row mt-5" style="font-size:13px;">
                            <div class="col-4 text-center">
                                <div style="border-top:1px solid #000; padding-top:5px; margin-top:40px;">
                                    Received By (Store)<br/>
                                    <small class="text-muted"><span t-field="o.received_by"/></small>
                                </div>
                            </div>
                            <div class="col-4 text-center">
                                <div style="border-top:1px solid #000; padding-top:5px; margin-top:40px;">
                                    Supplier Representative
                                </div>
                            </div>
                            <div class="col-4 text-center">
                                <div style="border-top:1px solid #000; padding-top:5px; margin-top:40px;">
                                    Security / Gate
                                </div>
                            </div>
                        </div>

                        <p class="text-center text-muted mt-4">
                            <small>System-generated document. GRN: <span t-field="o.name"/> | <span t-field="o.date"/></small>
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
