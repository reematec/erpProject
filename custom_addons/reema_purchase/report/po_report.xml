<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        HTML preview report for Purchase Orders, following the house standard
        (custom_addons/REPORTS.md): report_type="qweb-html" (no PDF/wkhtmltopdf),
        no binding_model_id (kept OUT of the cog Print menu). Triggered by
        action_print_po(), which opens /report/html/... in a new tab; the user
        prints with the browser. Serves a single PO (form) or several selected
        POs (list).
    -->
    <record id="report_purchase_order" model="ir.actions.report">
        <field name="name">Purchase Order</field>
        <field name="model">reema.purchase.order</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">reema_purchase.report_purchase_order_template</field>
        <field name="report_file">reema_purchase.report_purchase_order_template</field>
        <field name="print_report_name">'PO - %s' % (object.name)</field>
    </record>

    <template id="report_purchase_order_template">
        <t t-call="web.html_container">
            <!-- No in-page toolbar: user prints with Ctrl+P and closes the tab. -->
            <style>
                @media print {
                    /* Each document is header+article+footer siblings from
                       web.external_layout. Break before every document except
                       the first: the boundary is a .footer immediately followed
                       by the next .header. */
                    .footer + .header { page-break-before: always; }
                }
                @page { margin: 12mm; }
            </style>
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page po_doc" style="font-size:12px;">

                        <!-- Title: Purchase Order + PO number -->
                        <div class="row mt-2 mb-2">
                            <div class="col-12">
                                <h3 class="mb-0 text-uppercase">Purchase Order</h3>
                                <h5 class="mt-1 mb-0"><span t-field="o.name"/></h5>
                            </div>
                        </div>

                        <hr style="margin-top:4px;"/>

                        <!-- Header details + supplier -->
                        <div class="row mt-3">
                            <div class="col-7">
                                <table class="table table-sm table-borderless">
                                    <tr>
                                        <td style="width:45%;"><strong>Date</strong></td>
                                        <td><t t-esc="o.date" t-options="{'widget':'date'}"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Status</strong></td>
                                        <td><t t-esc="dict(o._fields['state'].selection).get(o.state, o.state)"/></td>
                                    </tr>
                                    <tr t-if="o.date_expected">
                                        <td><strong>Expected Delivery</strong></td>
                                        <td><t t-esc="o.date_expected" t-options="{'widget':'date'}"/></td>
                                    </tr>
                                    <tr t-if="o.partner_ref">
                                        <td><strong>RFQ Ref</strong></td>
                                        <td><t t-esc="o.partner_ref"/></td>
                                    </tr>
                                    <tr t-if="o.payment_term_id">
                                        <td><strong>Payment Terms</strong></td>
                                        <td><t t-esc="o.payment_term_id.name"/></td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-5">
                                <table class="table table-sm table-borderless">
                                    <tr>
                                        <td><strong>Supplier</strong></td>
                                    </tr>
                                </table>
                                <address class="mb-0">
                                    <span t-field="o.partner_id.name"/><br/>
                                    <t t-if="o.partner_id.street"><span t-field="o.partner_id.street"/><br/></t>
                                    <t t-if="o.partner_id.city"><span t-field="o.partner_id.city"/>, </t>
                                    <t t-if="o.partner_id.country_id"><span t-field="o.partner_id.country_id.name"/></t>
                                    <t t-if="o.partner_id.phone"><br/>Tel: <span t-field="o.partner_id.phone"/></t>
                                </address>
                            </div>
                        </div>

                        <!-- Line Items -->
                        <h5 class="mt-3 mb-1">Order Lines</h5>
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr class="table-dark">
                                    <th>#</th>
                                    <th>Product / Material</th>
                                    <th>Description</th>
                                    <th>Color</th>
                                    <th>Thickness / Spec</th>
                                    <th class="text-end">Qty</th>
                                    <th>Unit</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.line_ids" t-as="line">
                                    <tr>
                                        <td><t t-esc="line_index + 1"/></td>
                                        <td><t t-esc="line.product_id.display_name"/></td>
                                        <td><t t-esc="line.name or ''"/></td>
                                        <td><t t-esc="line.color or '—'"/></td>
                                        <td><t t-esc="line.thickness or '—'"/></td>
                                        <td class="text-end"><t t-esc="line.product_qty"/></td>
                                        <td><t t-esc="line.product_uom_id.name"/></td>
                                        <td class="text-end">
                                            <t t-esc="line.price_unit" t-options="{'widget':'monetary','display_currency':o.currency_id}"/>
                                        </td>
                                        <td class="text-end">
                                            <t t-esc="line.price_subtotal" t-options="{'widget':'monetary','display_currency':o.currency_id}"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Totals -->
                        <div class="row">
                            <div class="col-5 offset-7">
                                <table class="table table-sm table-borderless">
                                    <tr>
                                        <td><strong>Subtotal</strong></td>
                                        <td class="text-end">
                                            <t t-esc="o.amount_untaxed" t-options="{'widget':'monetary','display_currency':o.currency_id}"/>
                                        </td>
                                    </tr>
                                    <tr t-if="o.amount_tax">
                                        <td><strong>Tax</strong></td>
                                        <td class="text-end">
                                            <t t-esc="o.amount_tax" t-options="{'widget':'monetary','display_currency':o.currency_id}"/>
                                        </td>
                                    </tr>
                                    <tr class="border-top">
                                        <td><strong>Total</strong></td>
                                        <td class="text-end"><strong>
                                            <t t-esc="o.amount_total" t-options="{'widget':'monetary','display_currency':o.currency_id}"/>
                                        </strong></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Notes -->
                        <div t-if="o.notes" class="mt-3">
                            <strong>Terms &amp; Conditions:</strong>
                            <p><t t-esc="o.notes"/></p>
                        </div>

                        <!-- Signatures -->
                        <div class="row mt-5">
                            <div class="col-4 text-center">
                                <div style="border-top:1px solid #000; padding-top:5px; margin-top:40px;">
                                    Prepared By<br/>
                                    <small class="text-muted"><t t-esc="o.buyer_id.name"/></small>
                                </div>
                            </div>
                            <div class="col-4 text-center">
                                <div style="border-top:1px solid #000; padding-top:5px; margin-top:40px;">
                                    Confirmed By (Production Manager)
                                </div>
                            </div>
                            <div class="col-4 text-center">
                                <div style="border-top:1px solid #000; padding-top:5px; margin-top:40px;">
                                    Approved By (Owner)
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
