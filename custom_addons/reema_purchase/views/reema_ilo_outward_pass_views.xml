<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Form View ──────────────────────────────────────────────────── -->
    <record id="view_reema_ilo_outward_pass_form" model="ir.ui.view">
        <field name="name">reema.ilo.outward.pass.form</field>
        <field name="model">reema.ilo.outward.pass</field>
        <field name="arch" type="xml">
            <form string="ILO Outward Pass">
                <header>
                    <button name="action_confirm" string="Confirm Exit" type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"
                            confirm="Confirm this vehicle has exited with the attached dispatches?"/>
                    <button name="action_reset_to_draft" string="Reverse Exit" type="object"
                            class="btn-warning"
                            invisible="state != 'confirmed'"
                            groups="reema_purchase.group_reema_purchase_manager"
                            confirm="Are you sure you want to reverse this ILO Outward Pass back to Draft?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Pass Info">
                            <field name="date" readonly="state == 'confirmed'"/>
                            <field name="contractor_id"
                                   options="{'no_create': True, 'no_edit': True, 'no_open': True}"
                                   readonly="state == 'confirmed'"/>
                            <field name="created_by" readonly="1"/>
                        </group>
                        <group string="Vehicle">
                            <field name="vehicle_no" readonly="state == 'confirmed'"/>
                            <field name="driver_name" readonly="state == 'confirmed'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Dispatches" name="dispatches">
                            <field name="line_ids" readonly="state == 'confirmed'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="dispatch_id"
                                           domain="[('state','=','dispatched'), ('is_outward_passed','=',False), ('contractor_id','=',parent.contractor_id)] if parent.contractor_id else [('state','=','dispatched'), ('is_outward_passed','=',False)]"
                                           options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                                    <field name="mo_id"/>
                                    <field name="ball_size" optional="show"/>
                                    <field name="construction_type" optional="show"/>
                                    <field name="qty_balls"/>
                                </list>
                            </field>
                        </page>
                        <page string="Remarks" name="remarks">
                            <field name="remarks" placeholder="Any notes..." readonly="state == 'confirmed'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── List View ──────────────────────────────────────────────────── -->
    <record id="view_reema_ilo_outward_pass_list" model="ir.ui.view">
        <field name="name">reema.ilo.outward.pass.list</field>
        <field name="model">reema.ilo.outward.pass</field>
        <field name="arch" type="xml">
            <list string="ILO Outward Passes"
                  decoration-warning="state == 'draft'"
                  decoration-success="state == 'confirmed'">
                <field name="name" optional="show"/>
                <field name="date" optional="show"/>
                <field name="contractor_id" optional="show"
                       options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                <field name="vehicle_no" optional="hide"/>
                <field name="driver_name" optional="hide"/>
                <field name="total_qty_balls" string="Total Balls" optional="show"/>
                <field name="created_by" optional="hide"/>
                <field name="state" widget="badge" optional="hide"
                       decoration-warning="state == 'draft'"
                       decoration-success="state == 'confirmed'"/>
            </list>
        </field>
    </record>

    <!-- ── Search View ────────────────────────────────────────────────── -->
    <record id="view_reema_ilo_outward_pass_search" model="ir.ui.view">
        <field name="name">reema.ilo.outward.pass.search</field>
        <field name="model">reema.ilo.outward.pass</field>
        <field name="arch" type="xml">
            <search string="Search ILO Outward Passes">
                <field name="name"/>
                <field name="contractor_id"/>
                <field name="vehicle_no"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Sent" name="confirmed" domain="[('state','=','confirmed')]"/>
            </search>
        </field>
    </record>

    <!-- ── Action ─────────────────────────────────────────────────────── -->
    <record id="action_reema_ilo_outward_pass" model="ir.actions.act_window">
        <field name="name">ILO Outward Passes</field>
        <field name="res_model">reema.ilo.outward.pass</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_reema_ilo_outward_pass_search"/>
    </record>

</odoo>
