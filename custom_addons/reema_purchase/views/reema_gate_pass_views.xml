<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Form View ──────────────────────────────────────────────────── -->
    <record id="view_reema_gate_pass_form" model="ir.ui.view">
        <field name="name">reema.gate.pass.form</field>
        <field name="model">reema.gate.pass</field>
        <field name="arch" type="xml">
            <form string="Inward Gate Pass">
                <header>
                    <button name="action_confirm" string="Forward to Store"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"
                            confirm="Confirm arrival and forward this Inward Gate Pass to the Store Keeper?"/>
                    <button name="action_reset_to_draft" string="Reverse Store"
                            type="object" class="btn-warning"
                            invisible="state != 'confirmed'"
                            groups="reema_purchase.group_reema_purchase_manager"
                            confirm="Are you sure you want to reverse this gate pass back to Arrived?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_grn" type="object"
                                class="oe_stat_button" icon="fa-clipboard-check"
                                groups="reema_mrp.group_reema_store,reema_purchase.group_reema_purchase_manager,account.group_account_invoice"
                                invisible="grn_count == 0">
                            <field name="grn_count" widget="statinfo" string="GRNs"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Arrival Info">
                            <field name="date" readonly="state == 'confirmed'"/>
                            <field name="po_id"
                                   options="{'no_create': True, 'no_edit': True, 'no_open': True}"
                                   readonly="state == 'confirmed'"/>
                            <field name="partner_id"
                                   options="{'no_create': True, 'no_edit': True, 'no_open': True}"
                                   readonly="state == 'confirmed'"/>
                        </group>
                        <group string="Vehicle / Carrier">
                            <field name="vehicle_no" readonly="state == 'confirmed'"/>
                            <field name="driver_name" readonly="state == 'confirmed'"/>
                            <field name="carrier" readonly="state == 'confirmed'"/>
                            <field name="no_of_packages" readonly="state == 'confirmed'"/>
                            <field name="security_guard" readonly="state == 'confirmed'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Items Arrived" name="items">
                            <field name="line_ids" readonly="state == 'confirmed'">
                                <form>
                                    <group>
                                        <group string="Product">
                                            <field name="product_id"
                                                   options="{'no_create': True, 'no_edit': True, 'no_open': True}"
                                                   placeholder="Select from system..."/>
                                            <field name="product_name" placeholder="Or type custom product name..."/>
                                            <field name="description"/>
                                            <field name="product_uom_id"
                                                   options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                                            <field name="color"/>
                                            <field name="thickness"/>
                                        </group>
                                        <group string="Quantity">
                                            <field name="expected_qty" string="Expected (PO)" readonly="1"/>
                                            <field name="received_qty" string="Physically Arrived"/>
                                        </group>
                                    </group>
                                    <separator string="Attributes"/>
                                    <field name="attribute_ids">
                                        <list editable="bottom">
                                            <field name="sequence" widget="handle"/>
                                            <field name="attribute_name" string="Attribute" placeholder="e.g. Color"/>
                                            <field name="attribute_value" string="Value" placeholder="e.g. Red, Yellow"/>
                                        </list>
                                    </field>
                                </form>
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id" string="Product"
                                           options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                                    <field name="product_name" string="Custom Product"/>
                                    <field name="description"/>
                                    <field name="color" optional="show"/>
                                    <field name="thickness" optional="show"/>
                                    <field name="received_qty" string="Physically Arrived"/>
                                    <field name="product_uom_id"
                                           options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                                </list>
                            </field>
                        </page>
                        <page string="Remarks" name="remarks">
                            <field name="remarks" placeholder="Any notes about the delivery..."
                                   readonly="state == 'confirmed'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── List View ──────────────────────────────────────────────────── -->
    <record id="view_reema_gate_pass_list" model="ir.ui.view">
        <field name="name">reema.gate.pass.list</field>
        <field name="model">reema.gate.pass</field>
        <field name="arch" type="xml">
            <list string="Inward Gate Passes"
                  decoration-warning="state == 'draft'"
                  decoration-success="state == 'confirmed'">
                <field name="name" optional="show"/>
                <field name="date" optional="show"/>
                <field name="po_id" optional="show" options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                <field name="partner_id" optional="show" options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                <field name="product_summary" string="Products" optional="hide"/>
                <field name="custom_product_summary" string="Custom Products" optional="hide"/>
                <field name="total_arrived_qty" string="Arrived Qty" optional="show"/>
                <field name="vehicle_no" optional="hide"/>
                <field name="driver_name" optional="hide"/>
                <field name="no_of_packages" optional="hide"/>
                <field name="grn_count" string="GRNs" optional="hide"/>
                <field name="state" widget="badge" optional="hide"
                       decoration-warning="state == 'draft'"
                       decoration-success="state == 'confirmed'"/>
            </list>
        </field>
    </record>

    <!-- ── Search View ────────────────────────────────────────────────── -->
    <record id="view_reema_gate_pass_search" model="ir.ui.view">
        <field name="name">reema.gate.pass.search</field>
        <field name="model">reema.gate.pass</field>
        <field name="arch" type="xml">
            <search string="Search Inward Gate Passes">
                <field name="name"/>
                <field name="po_id"/>
                <field name="partner_id"/>
                <separator/>
                <filter string="Arrived" name="arrived" domain="[('state','=','draft')]"/>
                <filter string="Forwarded to Store" name="confirmed" domain="[('state','=','confirmed')]"/>
            </search>
        </field>
    </record>

    <!-- ── Action ─────────────────────────────────────────────────────── -->
    <record id="action_reema_gate_pass" model="ir.actions.act_window">
        <field name="name">Inward Gate Passes</field>
        <field name="res_model">reema.gate.pass</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_reema_gate_pass_search"/>
    </record>

</odoo>
