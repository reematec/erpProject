<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Form View ──────────────────────────────────────────────────── -->
    <record id="view_reema_grn_form" model="ir.ui.view">
        <field name="name">reema.grn.form</field>
        <field name="model">reema.grn</field>
        <field name="arch" type="xml">
            <form string="Goods Receipt Note">
                <header>
                    <button name="action_verify" string="Verify Receipt"
                            type="object" class="btn-primary"
                            invisible="state != 'draft' or name == 'New'"
                            confirm="Receive this GRN into store? This will increase stock and post the interim accounting entry."/>
                    <button name="action_print_grn" string="Print Receipt"
                            type="object" class="btn-secondary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,verified"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <div class="alert alert-success" role="alert"
                         invisible="state != 'verified'">
                        <strong>Material Logged:</strong> Stock increased and interim entry
                        <field name="move_id" readonly="1" nolabel="1"
                               options="{'no_create': True, 'no_edit': True, 'no_open': True}"
                               invisible="not move_id"/> posted.
                    </div>

                    <group>
                        <group string="Receipt Info">
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="gate_pass_id"
                                   options="{'no_create': True, 'no_edit': True, 'no_open': True}"
                                   domain="[('state', '=', 'confirmed'), ('grn_ids', '=', False)]"
                                   readonly="state != 'draft'"/>
                            <field name="po_id"
                                   options="{'no_create': True, 'no_edit': True, 'no_open': True}"
                                   readonly="gate_pass_id or state != 'draft'"
                                   domain="[('state', 'in', ('confirmed', 'approved'))]"/>
                            <field name="partner_id"
                                   options="{'no_create': True, 'no_edit': True, 'no_open': True}"
                                   readonly="po_id or state != 'draft'"/>
                        </group>
                        <group string="Staff">
                            <field name="received_by"
                                   options="{'no_create': True, 'no_edit': True, 'no_open': True}"
                                   readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Receipt Lines" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"
                                           options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                                    <field name="product_name" string="Custom Product" optional="hide"/>
                                    <field name="description"/>
                                    <field name="product_uom_id"
                                           options="{'no_create': True, 'no_edit': True, 'no_open': True}"
                                           string="Unit"/>
                                    <field name="ordered_qty" readonly="gate_pass_line_id or po_line_id" string="PO Qty"/>
                                    <field name="received_qty" string="Arrived Qty"/>
                                    <field name="accepted_qty" string="Accepted Qty"/>
                                    <field name="rejected_qty" readonly="1" string="Rejected"/>
                                    <field name="price_unit" string="Unit Price (PKR)"
                                           groups="reema_purchase.group_reema_purchase_manager"/>
                                    <field name="rejection_reason" optional="show"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right"
                                   groups="reema_purchase.group_reema_purchase_manager">
                                <field name="total_accepted_value" readonly="1"
                                       string="Total Accepted Value (PKR)"/>
                            </group>
                        </page>
                        <page string="Inspection" name="inspection">
                            <field name="inspection_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"
                                           options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                                    <field name="check_name" string="Check"/>
                                    <field name="sample_qty" string="Sample Size"/>
                                    <field name="expected_value" string="Expected"/>
                                    <field name="actual_value" string="Actual"/>
                                    <field name="result"
                                           decoration-success="result == 'pass'"
                                           decoration-danger="result == 'fail'"
                                           decoration-muted="result == 'na'"/>
                                    <field name="notes" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── List View ──────────────────────────────────────────────────── -->
    <record id="view_reema_grn_list" model="ir.ui.view">
        <field name="name">reema.grn.list</field>
        <field name="model">reema.grn</field>
        <field name="arch" type="xml">
            <list string="GRNs"
                  decoration-info="state == 'draft'"
                  decoration-success="state == 'verified'">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id" options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                <field name="total_accepted_qty" string="Total Qty"/>
                <field name="po_id" optional="show"
                       options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                <field name="gate_pass_id" optional="show"
                       options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                <field name="received_by" optional="hide"
                       options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                <field name="total_accepted_value" string="Value (PKR)" optional="show"
                       groups="reema_purchase.group_reema_purchase_manager"/>
                <field name="state" widget="badge" optional="show"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'verified'"/>
            </list>
        </field>
    </record>

    <!-- ── Search View ────────────────────────────────────────────────── -->
    <record id="view_reema_grn_search" model="ir.ui.view">
        <field name="name">reema.grn.search</field>
        <field name="model">reema.grn</field>
        <field name="arch" type="xml">
            <search string="Search GRNs">
                <field name="name"/>
                <field name="po_id"/>
                <field name="partner_id"/>
                <field name="gate_pass_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Verified" name="verified" domain="[('state','=','verified')]"/>
                <group expand="0" string="Group By">
                    <filter string="Supplier" name="by_supplier" context="{'group_by': 'partner_id'}"/>
                    <filter string="Status" name="by_state" context="{'group_by': 'state'}"/>
                    <filter string="Month" name="by_month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Action ─────────────────────────────────────────────────────── -->
    <record id="action_reema_grn" model="ir.actions.act_window">
        <field name="name">Goods Receipt Notes</field>
        <field name="res_model">reema.grn</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_reema_grn_search"/>
    </record>

</odoo>
