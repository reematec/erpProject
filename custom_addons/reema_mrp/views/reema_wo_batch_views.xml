<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Log Batch Progress wizard -->
    <record id="view_reema_batch_entry_wizard_form" model="ir.ui.view">
        <field name="name">reema.batch.entry.wizard.form</field>
        <field name="model">reema.batch.entry.wizard</field>
        <field name="arch" type="xml">
            <form string="Log Batch Progress">
                <group>
                    <group string="Work Order">
                        <field name="workorder_id" invisible="1"/>
                        <field name="workorder_name" readonly="1"/>
                        <field name="workcenter_name" readonly="1"/>
                        <field name="workcenter_id" invisible="1"/>
                    </group>
                    <group string="Progress">
                        <field name="hall_qty" string="Target" readonly="1"/>
                        <field name="qty_balance" readonly="1"/>
                        <field name="qty_predecessor_balance" string="Available from Previous Hall" readonly="1"/>
                    </group>
                </group>
                <group>
                    <field name="workforce_type" invisible="1"/>
                    <field name="available_contractor_ids" invisible="1"/>
                    <field name="contractor_id" options="{'no_create': True, 'no_edit': True}"
                           invisible="workforce_type == 'employee'"
                           required="workforce_type != 'employee'"/>
                    <field name="hall_unit" invisible="1"/>
                    <!-- Sheet halls (Lamination) -->
                    <field name="qty" string="Sheets Completed" autofocus="1"
                           invisible="hall_unit != 'sheet'"/>
                    <!-- Ball halls (Stitching, Shaping, QC, ...) -->
                    <field name="qty" string="Balls Completed" autofocus="1"
                           invisible="hall_unit != 'ball'"/>
                    <!-- Panel halls (Cutting, Printing, Sorting): bidirectional Balls <-> Panels, real-time -->
                    <field name="qty_balls_input" string="Balls Completed" autofocus="1"
                           widget="panels_balls_sync"
                           invisible="hall_unit != 'panel'"/>
                    <field name="qty" string="Panels Completed"
                           widget="panels_balls_sync"
                           invisible="hall_unit != 'panel'"/>
                    <field name="panels_per_ball" string="Panels per Ball" readonly="1"
                           invisible="hall_unit != 'panel'"/>
                    <field name="piece_rate_value" string="Rate (PKR)" readonly="1"
                           invisible="workforce_type == 'employee'"/>
                    <field name="notes" placeholder="Optional: e.g. 'Morning shift batch'" colspan="2"/>
                </group>
                <group invisible="not scrap_enabled">
                    <field name="scrap_enabled" invisible="1"/>
                    <field name="qty_scrap" string="Sheets Scrapped" invisible="hall_unit != 'sheet'"/>
                    <field name="qty_scrap" string="Balls Scrapped" invisible="hall_unit != 'ball'"/>
                    <field name="qty_scrap" string="Panels Scrapped" invisible="hall_unit != 'panel'"/>
                    <field name="scrap_reason_id" string="Scrap Reason" required="qty_scrap &gt; 0"
                           options="{'no_create': True, 'no_edit': True}"/>
                </group>
                <div class="alert alert-warning mb-0 mt-2" role="alert" invisible="not qty_warning">
                    <field name="qty_warning" readonly="1" nolabel="1"/>
                </div>
                <footer>
                    <button name="action_confirm" type="object" string="Save" class="btn-primary" data-hotkey="s"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Log ILO Balls Received wizard -->
    <record id="view_reema_ilo_receive_wizard_form" model="ir.ui.view">
        <field name="name">reema.ilo.receive.wizard.form</field>
        <field name="model">reema.ilo.receive.wizard</field>
        <field name="arch" type="xml">
            <form string="Log ILO Balls Received">
                <group>
                    <group string="Work Order">
                        <field name="workorder_id" invisible="1"/>
                        <field name="mo_id" invisible="1"/>
                        <field name="workorder_name" readonly="1"/>
                        <field name="workcenter_name" readonly="1"/>
                    </group>
                    <group string="Contractor">
                        <field name="available_contractor_ids" invisible="1"/>
                        <field name="contractor_id" options="{'no_create': True, 'no_edit': True}"/>
                        <field name="stitching_open" invisible="1"/>
                        <field name="repair_open" invisible="1"/>
                        <field name="stitching_balance_display" string="Stitching Balance" readonly="1"
                               invisible="not stitching_open"/>
                        <field name="repair_balance_display" string="Repair Balance" readonly="1"
                               invisible="not repair_open"/>
                    </group>
                </group>
                <group>
                    <field name="receipt_purpose"
                           invisible="not (stitching_open and repair_open)"
                           required="stitching_open and repair_open"/>
                    <field name="available_original_contractor_ids" invisible="1"/>
                    <field name="original_contractor_id"
                           invisible="receipt_purpose != 'repair'"
                           required="receipt_purpose == 'repair'"
                           options="{'no_create': True, 'no_edit': True}"/>
                    <field name="qty" string="Quantity Received" autofocus="1"/>
                    <field name="qty_lost" string="Balls Reported Lost"/>
                </group>
                <field name="notes" placeholder="Optional notes..." class="w-100"/>
                <footer>
                    <button name="action_confirm" type="object" string="Save" class="btn-primary" data-hotkey="s"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Initial QC wizard -->
    <record id="view_reema_ilo_qc_wizard_form" model="ir.ui.view">
        <field name="name">reema.ilo.qc.wizard.form</field>
        <field name="model">reema.ilo.qc.wizard</field>
        <field name="arch" type="xml">
            <form string="Initial QC">
                <group>
                    <group string="Work Order">
                        <field name="workorder_id" invisible="1"/>
                        <field name="mo_id" invisible="1"/>
                        <field name="workorder_name" readonly="1"/>
                        <field name="workcenter_name" readonly="1"/>
                        <field name="construction_type" invisible="1"/>
                    </group>
                    <group string="Contractor">
                        <field name="available_contractor_ids" invisible="1"/>
                        <field name="contractor_id" options="{'no_create': True, 'no_edit': True}"/>
                        <field name="qc_stitching_open" invisible="1"/>
                        <field name="qc_repair_open" invisible="1"/>
                        <field name="pending_qty" string="Pending Inspection (Total)" readonly="1"/>
                        <field name="pending_qty_stitching" string="Pending — First-Time" readonly="1"
                               invisible="not qc_stitching_open"/>
                        <field name="pending_qty_repair" string="Pending — Repair Return" readonly="1"
                               invisible="not qc_repair_open"/>
                    </group>
                </group>
                <group>
                    <field name="inspection_purpose"
                           invisible="not (qc_stitching_open and qc_repair_open)"
                           required="qc_stitching_open and qc_repair_open"/>
                    <field name="available_returning_repair_contractor_ids" invisible="1"/>
                    <field name="returning_repair_contractor_id"
                           invisible="inspection_purpose != 'repair'"
                           required="inspection_purpose == 'repair'"
                           options="{'no_create': True, 'no_edit': True}"/>
                </group>
                <group>
                    <group string="Inspection Result">
                        <field name="qty_pass" string="Pass Qty" autofocus="1"/>
                        <field name="qty_fail" string="Fail Balls"
                               invisible="construction_type != 'hs'"/>
                        <field name="repair_count" string="Number of Repairs"
                               invisible="construction_type != 'hs'" required="qty_fail != 0"/>
                        <field name="repair_defect_type" required="qty_fail != 0"/>
                        <field name="repair_contractor_id" options="{'no_create': True, 'no_edit': True}"/>
                    </group>
                    <group string="Scrap / Write-off">
                        <field name="qty_scrap" string="Scrap / Write-off Qty"/>
                        <field name="scrap_defect_type" required="qty_scrap != 0"/>
                    </group>
                </group>
                <group col="1">
                    <field name="notes" placeholder="Optional notes..." nolabel="1" class="w-100"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Save" class="btn-primary" data-hotkey="s"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Final QC wizard -->
    <record id="view_reema_final_qc_wizard_form" model="ir.ui.view">
        <field name="name">reema.final.qc.wizard.form</field>
        <field name="model">reema.final.qc.wizard</field>
        <field name="arch" type="xml">
            <form string="Final QC">
                <group string="Work Order">
                    <field name="workorder_id" invisible="1"/>
                    <field name="mo_id" invisible="1"/>
                    <field name="workorder_name" readonly="1"/>
                    <field name="workcenter_name" readonly="1"/>
                    <field name="construction_type" invisible="1"/>
                </group>
                <group>
                    <field name="qty_pass" string="Pass Qty" autofocus="1"/>
                </group>
                <separator string="Only if there's a fault — repair or scrap"/>
                <group>
                    <field name="available_contractor_ids" invisible="1"/>
                    <field name="contractor_id" string="Original Contractor"
                           options="{'no_create': True, 'no_edit': True}"
                           required="qty_fail != 0 or qty_scrap != 0"/>
                </group>
                <group>
                    <group string="Repair">
                        <field name="qty_fail" string="Fail Balls"
                               readonly="construction_type != 'hs'"/>
                        <field name="repair_count" string="Number of Repairs"
                               invisible="construction_type != 'hs'" required="qty_fail != 0"/>
                        <field name="repair_defect_type" required="qty_fail != 0"/>
                        <field name="repair_contractor_id" options="{'no_create': True, 'no_edit': True}"
                               required="qty_fail != 0"/>
                    </group>
                    <group string="Scrap">
                        <field name="qty_scrap" string="Scrap / Write-off Qty"/>
                        <field name="scrap_defect_type" required="qty_scrap != 0"/>
                    </group>
                </group>
                <field name="notes" placeholder="Optional notes..." class="w-100"/>
                <footer>
                    <button name="action_confirm" type="object" string="Save" class="btn-primary" data-hotkey="s"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Receive Repaired Ball (Final QC) wizard -->
    <record id="view_reema_final_qc_receive_wizard_form" model="ir.ui.view">
        <field name="name">reema.final.qc.receive.wizard.form</field>
        <field name="model">reema.final.qc.receive.wizard</field>
        <field name="arch" type="xml">
            <form string="Receive Repaired Ball">
                <group>
                    <group string="Work Order">
                        <field name="workorder_id" invisible="1"/>
                        <field name="mo_id" invisible="1"/>
                        <field name="workorder_name" readonly="1"/>
                        <field name="workcenter_name" readonly="1"/>
                    </group>
                    <group string="Repair">
                        <field name="available_contractor_ids" invisible="1"/>
                        <field name="contractor_id" options="{'no_create': True, 'no_edit': True}"/>
                        <field name="available_original_contractor_ids" invisible="1"/>
                        <field name="original_contractor_id" options="{'no_create': True, 'no_edit': True}"/>
                        <field name="balance_display" string="Outstanding" readonly="1"/>
                    </group>
                </group>
                <group>
                    <field name="qty" autofocus="1"/>
                    <field name="qty_reject"/>
                    <field name="qty_scrap"/>
                    <field name="scrap_defect_type" required="qty_scrap != 0"/>
                    <field name="qty_lost"/>
                </group>
                <div class="alert alert-danger mb-0 mt-2" role="alert" invisible="not qty_warning">
                    <field name="qty_warning" readonly="1" nolabel="1"/>
                </div>
                <field name="notes" placeholder="Optional notes..." class="w-100"/>
                <footer>
                    <button name="action_confirm" type="object" string="Save" class="btn-primary" data-hotkey="s"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Quality Check wizard (Hybrid / Machine-Stitched Initial + Final QC) -->
    <record id="view_reema_repair_qc_wizard_form" model="ir.ui.view">
        <field name="name">reema.repair.qc.wizard.form</field>
        <field name="model">reema.repair.qc.wizard</field>
        <field name="arch" type="xml">
            <form string="Quality Check">
                <group string="Work Order">
                    <field name="workorder_id" invisible="1"/>
                    <field name="mo_id" invisible="1"/>
                    <field name="workcenter_id" invisible="1"/>
                    <field name="workorder_name" readonly="1"/>
                    <field name="workcenter_name" readonly="1"/>
                </group>
                <group>
                    <field name="qty_pass" string="Pass Qty" autofocus="1"/>
                </group>
                <separator string="Only if there's a fault — repair or scrap"/>
                <group>
                    <group string="Fault">
                        <field name="available_fault_workcenter_ids" invisible="1"/>
                        <field name="available_fault_contractor_ids" invisible="1"/>
                        <field name="fault_workcenter_id" required="qty_fail != 0 or qty_scrap != 0"
                               options="{'no_create': True, 'no_edit': True}"/>
                        <field name="fault_contractor_id" required="qty_fail != 0 or qty_scrap != 0"
                               options="{'no_create': True, 'no_edit': True}"/>
                    </group>
                    <group string="Repair">
                        <field name="qty_fail" string="Fail Qty (Balls)"/>
                        <field name="repair_count" string="Number of Repairs" required="qty_fail != 0"/>
                        <field name="defect_type" required="qty_fail != 0"/>
                        <field name="available_repair_contractor_ids" invisible="1"/>
                        <field name="repair_contractor_id" required="qty_fail != 0"
                               options="{'no_create': True, 'no_edit': True}"/>
                    </group>
                    <group string="Scrap">
                        <field name="qty_scrap" string="Scrap / Write-off Qty"/>
                        <field name="scrap_reason_id" string="Scrap Reason" required="qty_scrap != 0"
                               options="{'no_create': True, 'no_edit': True}"/>
                    </group>
                </group>
                <field name="notes" placeholder="Optional notes..." class="w-100"/>
                <footer>
                    <button name="action_confirm" type="object" string="Save" class="btn-primary" data-hotkey="s"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Standalone list view for all batch entries -->
    <record id="reema_batch_entry_view_list" model="ir.ui.view">
        <field name="name">reema.wo.batch.entry.list</field>
        <field name="model">reema.wo.batch.entry</field>
        <field name="arch" type="xml">
            <list string="Batch Logs" default_order="date desc" create="0" delete="0">
                <header>
                    <button name="action_create_contractor_bill" type="object"
                            string="Create Contractor Bill" class="btn-primary"
                            confirm="Create a vendor bill for the selected unbilled batch entries? All entries must belong to the same contractor."/>
                    <button name="action_exclude_from_payment" type="object"
                            string="Exclude from Payment" class="btn-warning"
                            confirm="Mark the selected batch entries as NOT to be paid? They will be removed from the unbilled list and will not be added to any contractor bill.&#10;&#10;⚠ WARNING: This action CANNOT be reversed. Once a log is excluded from payment it stays excluded — make absolutely sure before you proceed."/>
                    <button name="action_include_in_payment" type="object"
                            string="Include in Payment" class="btn-secondary"
                            groups="base.group_system"
                            confirm="Re-include the selected batch entries in payment? They will reappear in the unbilled list and become billable again. Proceed?"/>
                    <button name="action_supervisor_delete" type="object"
                            string="Delete" class="btn-danger"
                            confirm="This will permanently delete the batch entry AND reverse all inventory movements (SFG product and raw material consumption). This action cannot be undone. Supervisors only. Proceed?"/>
                </header>
                <field name="name" string="Reference" readonly="1" optional="show"/>
                <field name="date" string="Date" optional="show"/>
                <field name="logged_by" string="Logged By" optional="hide"/>
                <field name="contractor_id" string="Contractor" optional="show"/>
                <field name="original_contractor_id" string="Original Contractor" optional="hide"/>
                <field name="ilo_dispatch_type" string="ILO Flow" optional="hide"/>
                <field name="repair_job_id" string="Repair Job" optional="hide"
                       options="{'no_create': True, 'no_edit': True}"/>
                <field name="reema_po_id" string="PO" optional="show"/>
                <field name="mo_id" string="MO" optional="show"/>
                <field name="process_name" string="Process" optional="show"/>
                <field name="qty" string="Qty" optional="show"/>
                <field name="qty_balls" string="Balls" optional="show"/>
                <field name="piece_rate_id" string="Rate" optional="show"
                       options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                <field name="piece_rate_value" string="Rate (PKR)" optional="hide"
                       widget="zero_dash_float"/>
                <field name="amount_earned" string="Amount" sum="Total" optional="show"/>
                <field name="is_billed" string="Billed" widget="boolean_toggle" readonly="1" optional="show"/>
                <field name="payment_excluded" string="Excluded" widget="boolean_toggle" readonly="1" optional="show"/>
                <field name="exclusion_reason" string="Exclusion Reason" optional="hide"/>
                <field name="bill_id" string="Bill Ref" optional="show"
                       context="{'form_view_ref': 'reema_accounting.view_contractor_bill_form'}"/>
                <field name="notes" string="Notes" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form view for batch entry (read-only detail) -->
    <record id="reema_batch_entry_view_form" model="ir.ui.view">
        <field name="name">reema.wo.batch.entry.form</field>
        <field name="model">reema.wo.batch.entry</field>
        <field name="arch" type="xml">
            <form string="Batch Log" create="false">
                <sheet>
                    <field name="workforce_type" invisible="1"/>
                    <field name="ilo_dispatch_type" invisible="1"/>
                    <field name="is_initial_qc_entry" invisible="1"/>
                    <group>
                        <group string="Work Order">
                            <field name="workorder_id" readonly="1" options="{'no_open': True}"/>
                            <field name="mo_id" string="Manufacturing Order" readonly="1"/>
                            <field name="date" readonly="1"/>
                            <field name="logged_by" readonly="1"/>
                        </group>
                        <group string="Contractor"
                               invisible="workforce_type == 'employee' and not ilo_dispatch_type and not is_initial_qc_entry">
                            <field name="contractor_id" readonly="1" options="{'no_open': True}"/>
                            <field name="original_contractor_id" readonly="1" invisible="not ilo_dispatch_type"/>
                            <field name="qc_received_qty" readonly="1" invisible="not is_initial_qc_entry"/>
                        </group>
                    </group>
                    <group>
                        <group string="Quantity">
                            <field name="qty" readonly="1"/>
                            <field name="qty_balls" readonly="1"/>
                        </group>
                        <group string="Piece Rate"
                               invisible="workforce_type == 'employee' and not ilo_dispatch_type and not is_initial_qc_entry">
                            <field name="piece_rate_id" readonly="1" options="{'no_open': True}"/>
                            <field name="piece_rate_value" string="Rate (PKR)" readonly="1"/>
                            <field name="amount_earned" readonly="1"/>
                        </group>
                    </group>
                    <group invisible="not is_initial_qc_entry">
                        <group string="Inspection Result">
                            <field name="qc_pass_qty" readonly="1"/>
                            <field name="qc_repair_qty" readonly="1"/>
                            <field name="qc_scrap_qty" readonly="1"/>
                            <field name="qc_scrap_defect_types" readonly="1" invisible="not qc_scrap_qty"/>
                        </group>
                        <group string="Repair Dispatch" invisible="not qc_repair_qty">
                            <field name="qc_repair_defect_types" readonly="1"/>
                            <field name="qc_repair_contractor_ids" readonly="1" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" readonly="1"/>
                    </group>
                    <group string="Payment"
                           invisible="workforce_type == 'employee' and not ilo_dispatch_type and not is_initial_qc_entry">
                        <field name="payment_excluded" readonly="1"/>
                        <field name="exclusion_reason" invisible="not payment_excluded"/>
                    </group>
                    <group invisible="not is_billed">
                        <field name="bill_id" readonly="1"
                               context="{'form_view_ref': 'reema_accounting.view_contractor_bill_form'}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search view -->
    <record id="reema_batch_entry_view_search" model="ir.ui.view">
        <field name="name">reema.wo.batch.entry.search</field>
        <field name="model">reema.wo.batch.entry</field>
        <field name="arch" type="xml">
            <search string="Batch Logs">
                <field name="logged_by" string="Logged By"/>
                <field name="contractor_id" string="Contractor"/>
                <field name="workorder_id" string="Work Order"/>
                <field name="reema_po_id" string="Production Order"/>
                <field name="mo_id" string="Manufacturing Order"/>
                <field name="piece_rate_id" string="Piece Rate"/>
                <filter string="Unbilled" name="unbilled" domain="[('is_billed', '=', False), ('payment_excluded', '=', False)]"/>
                <filter string="Billed"   name="billed"   domain="[('is_billed', '=', True)]"/>
                <filter string="Excluded from Payment" name="excluded" domain="[('payment_excluded', '=', True)]"/>
                <separator/>
                <filter string="Today" name="today"
                        domain="[('date', '>=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <filter string="This Month" name="this_month"
                        domain="[('date', '>=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Logged By" name="group_logged_by" context="{'group_by': 'logged_by'}"/>
                    <filter string="Contractor" name="group_contractor" context="{'group_by': 'contractor_id'}"/>
                    <filter string="Work Order" name="group_wo" context="{'group_by': 'workorder_id'}"/>
                    <filter string="Production Order" name="group_po" context="{'group_by': 'reema_po_id'}"/>
                    <filter string="Manufacturing Order" name="group_mo" context="{'group_by': 'mo_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Per-work-order progress log — used by the "Balls Done" click-through
         (action_view_batch_log on mrp.workorder) for cross-checking production
         progress in case of a dispute. Deliberately stripped down from the
         payment-oriented Batch Logs list above: one Qty column (the hall's own
         logging unit — sheets/panels/balls — not also a second "Balls
         Equivalent" figure, which is a conversion for internal costing, not a
         second physical quantity), no Rate/Amount/Billed/Excluded/Bill Ref —
         none of that is relevant to "how much was physically logged and by
         whom." Fully read-only: this view exists to verify history, not edit it. -->
    <record id="reema_batch_entry_view_list_progress" model="ir.ui.view">
        <field name="name">reema.wo.batch.entry.list.progress</field>
        <field name="model">reema.wo.batch.entry</field>
        <field name="arch" type="xml">
            <list string="Progress Log" create="0" delete="0" edit="0" default_order="date asc">
                <field name="workforce_type" column_invisible="1"/>
                <field name="ilo_dispatch_type" column_invisible="1"/>
                <field name="is_initial_qc_entry" column_invisible="1"/>
                <field name="is_final_qc_entry" column_invisible="1"/>
                <field name="name" string="Reference" readonly="1"/>
                <field name="date" string="Date" readonly="1"/>
                <field name="logged_by" string="Logged By" readonly="1"/>
                <!-- Employee-staffed halls (Initial QC, Final QC) still carry a
                     meaningful contractor_id — it's whose production is being
                     inspected/repaired, not who staffed the hall. Mirrors the same
                     condition already used on the detailed form view below. -->
                <field name="contractor_id" string="Contractor" readonly="1"
                       invisible="workforce_type == 'employee' and not ilo_dispatch_type and not is_initial_qc_entry and not is_final_qc_entry"/>
                <field name="qty" string="Qty" readonly="1" sum="Total"/>
                <field name="qty_balls" string="Balls Done" readonly="1" sum="Total"/>
                <!-- Initial/Final QC only — what THIS decision sent to repair/scrap
                     alongside its pass qty (0/blank for entries logged before this
                     linkage existed, and for halls other than Initial/Final QC). -->
                <field name="entry_repair_qty" string="Repair Qty" readonly="1" sum="Total"
                       invisible="not is_initial_qc_entry and not is_final_qc_entry"/>
                <field name="entry_repair_defect_types" string="Repair Reason" readonly="1"
                       invisible="(not is_initial_qc_entry and not is_final_qc_entry) or not entry_repair_qty"/>
                <field name="entry_scrap_qty" string="Scrap Qty" readonly="1" sum="Total"
                       invisible="not is_initial_qc_entry and not is_final_qc_entry"/>
                <field name="entry_scrap_defect_types" string="Scrap Reason" readonly="1"
                       invisible="(not is_initial_qc_entry and not is_final_qc_entry) or not entry_scrap_qty"/>
                <field name="notes" string="Notes" readonly="1" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Stored action scoped to one work order via active_id — needed so the
         "Balls Done" click-through (action_view_batch_log on mrp.workorder) can
         address it by a real numeric action id and open it as a new browser tab
         (/odoo/<active_id>/action-<id>), which a plain inline action dict cannot do. -->
    <record id="reema_batch_entry_action_from_workorder" model="ir.actions.act_window">
        <field name="name">Batch Log</field>
        <field name="res_model">reema.wo.batch.entry</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="reema_batch_entry_view_search"/>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('reema_batch_entry_view_list_progress')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('reema_batch_entry_view_form')}),
        ]"/>
        <field name="domain">[('workorder_id', '=', active_id)]</field>
    </record>

    <!-- Window action — Unbilled is the default filter -->
    <record id="reema_batch_entry_action" model="ir.actions.act_window">
        <field name="name">Batch Logs</field>
        <field name="res_model">reema.wo.batch.entry</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="reema_batch_entry_view_search"/>
        <!-- ILO Issuance/Stitching-Receive entries are provisional ledger records,
             not payable lines — only Initial QC carries the real payable qty/rate
             for a contractor's own stitching work. Full detail for those still
             lives under ILO Dispatches / ILO Received. Repair-Receive entries are
             the exception: they carry a real piece_rate_id (assigned automatically
             at receive time, see ReemaIloReceiveWizard.action_confirm) and ARE
             payable to whoever performed the repair — let through here regardless
             of Ball Receive Point being an employee-staffed hall (which would
             otherwise be filtered out below), alongside Final QC's own repair
             receipts.
             Plain employee-hall entries (Shaping, Raw Material Store, etc.) are also
             excluded — nothing billable or QC-decision-worthy happens there. Initial
             QC and Final QC stay visible even though they're employee-type too, since
             their Pass entries carry the QC decision detail (received/passed/repair/
             scrap, contractor charges) that Batch Logs is deliberately extended for. -->
        <field name="domain">[
            ('workorder_id.workcenter_id.is_ilo', '=', False),
            '|',
                '&amp;',
                    ('workorder_id.workcenter_id.is_ball_receive_point', '=', True),
                    ('ilo_dispatch_type', '=', 'repair'),
                '&amp;',
                    ('workorder_id.workcenter_id.is_ball_receive_point', '=', False),
                    '|', '|',
                        ('workorder_id.workcenter_id.workforce_type', '!=', 'employee'),
                        ('workorder_id.workcenter_id.is_initial_qc', '=', True),
                        ('workorder_id.workcenter_id.is_final_qc', '=', True),
        ]</field>
        <field name="context">{'search_default_unbilled': 1, 'search_default_group_mo': 1, 'search_default_group_wo': 2}</field>
        <!-- Pinned explicitly: reema.wo.batch.entry now has more than one primary
             list view (see ILO Received), and Odoo's default-view fallback picks
             between same-priority views alphabetically by name — leaving this
             action to fall back silently is fragile. Pin both views so it can
             never be hijacked by a future view added for this model. -->
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('reema_batch_entry_view_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('reema_batch_entry_view_form')}),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No batch entries found.
            </p>
        </field>
    </record>

    <menuitem id="reema_batch_entry_menu"
              name="Batch Logs"
              parent="mrp.menu_mrp_manufacturing"
              action="reema_batch_entry_action"
              sequence="25"/>

    <!-- Server action: Create Contractor Bill (kept for data integrity; button is in list header) -->
    <record id="action_create_contractor_bill_server" model="ir.actions.server">
        <field name="name">Create Contractor Bill</field>
        <field name="model_id" ref="reema_mrp.model_reema_wo_batch_entry"/>
        <field name="state">code</field>
        <field name="code">action = records.action_create_contractor_bill()</field>
    </record>

    <!-- Smart button on res.partner form -->
    <record id="res_partner_reema_batch_form" model="ir.ui.view">
        <field name="name">res.partner.reema.batch.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_batch_entries"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-list-ul"
                        invisible="batch_entry_count == 0">
                    <field name="batch_entry_count" widget="statinfo" string="Batch Logs"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════
         SCRAP REASONS — configurable, per-hall-scoped cause list used by
         the Production Scrap qty on the Log Batch modal. Add new reasons
         here as new halls get scrap logging enabled.
    ═══════════════════════════════════════════════ -->

    <record id="view_reema_scrap_reason_list" model="ir.ui.view">
        <field name="name">reema.scrap.reason.list</field>
        <field name="model">reema.scrap.reason</field>
        <field name="arch" type="xml">
            <list string="Scrap Reasons" editable="bottom">
                <field name="name"/>
                <field name="workcenter_ids" widget="many2many_tags"
                       options="{'no_create': True}"/>
            </list>
        </field>
    </record>

    <record id="view_reema_scrap_reason_form" model="ir.ui.view">
        <field name="name">reema.scrap.reason.form</field>
        <field name="model">reema.scrap.reason</field>
        <field name="arch" type="xml">
            <form string="Scrap Reason">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="workcenter_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_reema_scrap_reason" model="ir.actions.act_window">
        <field name="name">Scrap Reasons</field>
        <field name="res_model">reema.scrap.reason</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No scrap reasons defined yet. Click New to add one.
            </p>
        </field>
    </record>

    <menuitem id="reema_mrp_menu_scrap_reasons"
              name="Scrap Reasons"
              parent="mrp.menu_mrp_configuration"
              action="action_reema_scrap_reason"
              groups="reema_mrp.group_reema_production_manager"
              sequence="21"/>

    <!-- ═══════════════════════════════════════════════
         PRODUCTION SCRAP — shop-floor scrap (Shaping, Printing, and other
         halls as they get enabled). Separate from ILO QC Scrap. Chargeable
         to a contractor only at contractor-staffed halls (e.g. Printing) —
         contractor_id/amount/is_billed stay blank at employee halls
         (e.g. Shaping), where scrap is never charged to anyone.
    ═══════════════════════════════════════════════ -->

    <record id="view_reema_production_scrap_list" model="ir.ui.view">
        <field name="name">reema.production.scrap.list</field>
        <field name="model">reema.production.scrap</field>
        <field name="arch" type="xml">
            <list string="Production Scrap" create="0" default_order="date desc">
                <header>
                    <button name="action_apply_selected_to_bill" type="object"
                            string="Add to Bill" class="btn-primary"
                            invisible="not context.get('reema_pick_bill_id')"/>
                </header>
                <field name="name" string="Reference"/>
                <field name="date"/>
                <field name="reema_product_id" string="Product"/>
                <field name="mo_id"/>
                <field name="reema_po_id" string="PO" optional="hide"/>
                <field name="workcenter_id" string="Hall"/>
                <field name="contractor_id" optional="show"/>
                <field name="qty" string="Qty Scrapped" sum="Total"/>
                <field name="reason_id" string="Reason"/>
                <field name="amount" string="Amount (PKR)" optional="show" sum="Total"/>
                <field name="is_billed" string="Billed" widget="boolean_toggle" optional="show"/>
                <field name="recorded_by"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <record id="view_reema_production_scrap_search" model="ir.ui.view">
        <field name="name">reema.production.scrap.search</field>
        <field name="model">reema.production.scrap</field>
        <field name="arch" type="xml">
            <search string="Production Scrap">
                <field name="name"/>
                <field name="mo_id"/>
                <field name="contractor_id"/>
                <field name="reason_id"/>
                <filter name="unbilled" string="Unbilled" domain="[('is_billed', '=', False)]"/>
                <filter name="billed" string="Billed" domain="[('is_billed', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_contractor" string="Contractor" context="{'group_by': 'contractor_id'}"/>
                    <filter name="group_hall" string="Hall" context="{'group_by': 'workcenter_id'}"/>
                    <filter name="group_mo" string="Manufacturing Order" context="{'group_by': 'mo_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_reema_production_scrap" model="ir.actions.act_window">
        <field name="name">Production Scrap</field>
        <field name="res_model">reema.production.scrap</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_reema_production_scrap_search"/>
    </record>

    <!-- ═══════════════════════════════════════════════
         SCRAP REPORT — combined read-only feed of ILO QC Scrap +
         Production Scrap, for a single "how many balls got
         scrapped" view across every source.
    ═══════════════════════════════════════════════ -->

    <record id="view_reema_scrap_report_list" model="ir.ui.view">
        <field name="name">reema.scrap.report.list</field>
        <field name="model">reema.scrap.report</field>
        <field name="arch" type="xml">
            <list string="Total Scrap" create="0" edit="0" delete="0" default_order="date desc">
                <field name="name" string="Reference" optional="show"/>
                <field name="date" optional="show"/>
                <field name="mo_id" optional="show"/>
                <field name="workcenter_id" string="Hall" optional="show"/>
                <field name="source" widget="badge" optional="show"/>
                <field name="contractor_id" string="Charged To" optional="show"/>
                <field name="qty" string="Qty Scrapped" sum="Total" optional="show"/>
                <field name="hall_unit" string="UOM" optional="show"/>
                <field name="reason" optional="show"/>
                <field name="recorded_by" optional="show"/>
                <field name="notes" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_reema_scrap_report" model="ir.actions.act_window">
        <field name="name">Total Scrap</field>
        <field name="res_model">reema.scrap.report</field>
        <field name="view_mode">list</field>
    </record>

    <!-- MO smart-button variant — active_id-scoped, opened as a new tab via
         mrp_production._action_view_url_new_tab -->
    <record id="action_reema_scrap_report_from_mo" model="ir.actions.act_window">
        <field name="name">Total Scrap</field>
        <field name="res_model">reema.scrap.report</field>
        <field name="view_mode">list</field>
        <field name="domain">[('mo_id', '=', active_id)]</field>
    </record>

    <menuitem id="menu_reema_scrap_report"
              name="Total Scrap"
              parent="mrp.menu_mrp_reporting"
              action="action_reema_scrap_report"
              sequence="30"/>

    <menuitem id="menu_reema_production_scrap"
              name="Production Scrap"
              parent="mrp.menu_mrp_reporting"
              action="action_reema_production_scrap"
              sequence="31"/>

</odoo>
