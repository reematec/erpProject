<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A run's own form view — opened from the Boxes list on the header
         form. Contents is PER BOX (one row per article — more than one row
         means a mixed box); No. of Boxes is how many identical boxes this
         one run covers. -->
    <record id="reema_box_packing_list_box_form_view" model="ir.ui.view">
        <field name="name">reema.box.packing.list.box.form</field>
        <field name="model">reema.box.packing.list.box</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_delete_box" type="object" string="Delete This Run"
                            class="btn-secondary" invisible="not carton_range"
                            confirm="Delete this run? All boxes in it will be removed too."/>
                </header>
                <sheet>
                    <div class="alert alert-info mb-3" role="alert">
                        <strong>Save &amp; Close</strong> / <strong>Save &amp; New</strong> only add
                        this run to the list below — nothing is checked or saved to the database
                        yet. Quantities are only validated when you save the Box Packing List
                        itself, so double-check the numbers here before saving it.
                    </div>
                    <group>
                        <group>
                            <field name="carton_size"/>
                            <field name="carton_weight"/>
                            <field name="carton_qty"/>
                        </group>
                        <group>
                            <field name="total_qty" readonly="1"/>
                            <field name="carton_range" string="Cartons" readonly="1"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="article_id" string="Article"
                                   domain="[('box_packing_id', '=', parent.box_packing_id)]"
                                   options="{'no_open': True, 'no_create': True, 'no_edit': True}"/>
                            <field name="description" optional="show" readonly="1"/>
                            <field name="client_sku" optional="show" readonly="1"/>
                            <field name="sample_color" optional="show" readonly="1"/>
                            <field name="size" optional="show" readonly="1"/>
                            <field name="qty" string="Per Box" optional="show"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="reema_box_packing_list_box_list_view" model="ir.ui.view">
        <field name="name">reema.box.packing.list.box.list</field>
        <field name="model">reema.box.packing.list.box</field>
        <field name="arch" type="xml">
            <list>
                <field name="carton_range" optional="show"/>
                <field name="carton_size" optional="show"/>
                <field name="carton_weight" optional="show"/>
                <field name="carton_qty" optional="show"/>
                <field name="contents_summary" optional="show"/>
                <field name="total_qty" optional="show"/>
            </list>
        </field>
    </record>

    <record id="reema_box_packing_list_list_view" model="ir.ui.view">
        <field name="name">reema.box.packing.list.list</field>
        <field name="model">reema.box.packing.list</field>
        <field name="arch" type="xml">
            <list duplicate="false">
                <field name="name" optional="show"/>
                <field name="date" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="container_no" optional="hide"/>
                <field name="total_boxes" optional="hide"/>
                <field name="total_amount" optional="show" groups="base.group_system"/>
                <field name="state" optional="show"/>
            </list>
        </field>
    </record>

    <record id="reema_box_packing_list_form_view" model="ir.ui.view">
        <field name="name">reema.box.packing.list.form</field>
        <field name="model">reema.box.packing.list</field>
        <field name="arch" type="xml">
            <form duplicate="false">
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary" invisible="state != 'draft'"
                            confirm="Confirm this Box Packing List? This will move the Finished Goods value of every article below into Cost of Goods Sold."/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state != 'confirmed'"
                            confirm="Cancel this Box Packing List? This will reverse the COGS entry and free up its batches for another Packing List."/>
                    <button name="action_print_box_packing_list" string="Print" type="object" class="btn-secondary"/>
                    <button class="btn btn-secondary btn-sm"
                            data-bs-toggle="modal"
                            data-bs-target="#reema_bpl_status_info_modal"
                            title="Box Packing List Status Reference"
                            groups="base.group_user">
                        <i class="fa fa-info-circle"/>
                    </button>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <div class="modal fade" id="reema_bpl_status_info_modal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-lg">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Box Packing List Status Reference</h5>
                                <a href="#" role="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"/>
                            </div>
                            <div class="modal-body">
                                <p style="font-size:13px;">
                                    Unlike the existing Packing List, this one can pack more than
                                    one article into the same box (e.g. to save courier charges),
                                    not just one article per box. Add every article being shipped
                                    under <strong>Articles</strong>, then under <strong>Boxes</strong>
                                    add one row per <em>run</em> of identical boxes — box size,
                                    weight, what's in each box, and how many boxes — e.g. one row
                                    for "357 boxes of Article A", plus a separate one-box row for a
                                    mixed or odd-sized last box. Every article's total quantity
                                    across all runs must match its ordered quantity before this can
                                    be confirmed.
                                </p>
                                <table class="table table-sm table-bordered" style="font-size:13px;">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width:140px">Status</th>
                                            <th>What it means &amp; available actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td><span class="badge text-bg-secondary">Draft</span></td>
                                            <td>Being built — add Articles and Boxes. Nothing is posted to
                                                accounting yet. Actions: <strong>Confirm</strong> (moves
                                                Finished Goods value to Cost of Goods Sold), <strong>Print</strong>.</td>
                                        </tr>
                                        <tr>
                                            <td><span class="badge text-bg-success">Confirmed</span></td>
                                            <td>COGS entry posted — the shipped quantities are locked in and can
                                                no longer be edited. Action: <strong>Cancel</strong> (reverses the
                                                COGS entry and frees the batches back up).</td>
                                        </tr>
                                        <tr>
                                            <td><span class="badge text-bg-danger">Cancelled</span></td>
                                            <td>The COGS entry was reversed. Start a new one for the same
                                                shipment if needed.</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="modal-footer">
                                <a href="#" role="button" class="btn btn-primary" data-bs-dismiss="modal">Close</a>
                            </div>
                        </div>
                    </div>
                </div>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" options="{'no_open': True, 'no_create': True, 'no_edit': True}"
                                   readonly="state != 'draft'"/>
                            <field name="client_address" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="container_no" readonly="state != 'draft'"/>
                            <field name="commercial_invoice_no" readonly="state != 'confirmed'"/>
                        </group>
                        <group>
                            <field name="total_boxes"/>
                            <field name="gross_weight"/>
                            <field name="net_weight"/>
                            <field name="total_amount" groups="base.group_system"/>
                            <field name="account_move_id" readonly="1" groups="base.group_system"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Articles">
                            <field name="article_ids" readonly="state != 'draft'"
                                   context="{'default_box_packing_id': id}">
                                <list editable="bottom">
                                    <field name="invoice_id" string="Order"
                                           domain="[('partner_id', '=', parent.partner_id)]"
                                           options="{'no_open': True, 'no_create': True, 'no_edit': True}"
                                           optional="show"/>
                                    <field name="pi_line_id" string="Article"
                                           domain="[('invoice_id', '=', invoice_id)]"
                                           options="{'no_open': True, 'no_create': True, 'no_edit': True}"
                                           optional="show"/>
                                    <field name="product_id" column_invisible="True"/>
                                    <field name="description" optional="show"/>
                                    <field name="client_sku" optional="show"/>
                                    <field name="sample_color" optional="show"/>
                                    <field name="size" optional="show"/>
                                    <field name="available_qty" readonly="1" optional="show"/>
                                    <field name="qty" optional="show"/>
                                    <field name="packed_qty" readonly="1" optional="show"/>
                                    <field name="box_count" readonly="1" optional="show"/>
                                    <field name="box_numbers" readonly="1" optional="show"/>
                                    <field name="sample_code" optional="hide"/>
                                    <field name="hs_code" optional="hide"/>
                                    <field name="ean" optional="hide"/>
                                    <field name="fg_amount" readonly="1" optional="show" groups="base.group_system"/>
                                </list>
                            </field>
                        </page>
                        <page string="Boxes">
                            <field name="box_ids" readonly="state != 'draft'"
                                   context="{'default_box_packing_id': id}"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="reema_box_packing_list_action" model="ir.actions.act_window">
        <field name="name">Box Packing List</field>
        <field name="res_model">reema.box.packing.list</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="reema_mrp_menu_box_packing_list"
              name="Box Packing List"
              parent="reema_mrp_menu_operations"
              action="reema_box_packing_list_action"
              groups="base.group_user"
              sequence="21"/>
</odoo>
