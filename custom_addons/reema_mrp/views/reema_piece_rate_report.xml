<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_piece_rate_list">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <!-- Screen-only toolbar. NB: do NOT use Bootstrap's `d-print-none` here:
                         in the report stylesheet (bootstrap_review_report.scss) it is
                         `display:none` UNCONDITIONALLY, so it is hidden even on screen.
                         We use our own `o_screen_only` class with a real @media print rule. -->
                    <style>
                        @media print {
                            .o_screen_only { display: none !important; }
                            .pr_group { page-break-inside: avoid; }
                        }
                        @page { margin: 12mm; }
                    </style>
                    <div class="o_screen_only mb-3 text-end">
                        <button type="button" class="btn btn-primary" onclick="window.print()">
                            Print
                        </button>
                        <button type="button" class="btn btn-secondary" onclick="window.close()">
                            Close
                        </button>
                    </div>
                    <div class="row mb-3">
                        <div class="col-12 text-center">
                            <h3 class="mb-0">Piece Rate List</h3>
                        </div>
                    </div>
                    <t t-foreach="grouped" t-as="grp">
                        <div class="pr_group">
                            <h5 class="mt-3 mb-1"><t t-esc="grp[0].name or 'Unassigned'"/></h5>
                            <table class="table table-sm table-striped">
                                <thead>
                                    <tr class="table-dark">
                                        <th>Type of Work</th>
                                        <th>Description / Notes</th>
                                        <th class="text-end">Rate (PKR)</th>
                                        <th>UOM</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="grp[1]" t-as="rate">
                                        <tr>
                                            <td><t t-esc="rate.work_type"/></td>
                                            <td><t t-esc="rate.description"/></td>
                                            <td class="text-end"><t t-esc="rate.rate"/></td>
                                            <td><t t-esc="rate.uom_id.name"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>
