<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="reema_packing_list_list_view" model="ir.ui.view">
        <field name="name">reema.packing.list.list</field>
        <field name="model">reema.packing.list</field>
        <field name="arch" type="xml">
            <list duplicate="false">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="container_no" optional="hide"/>
                <field name="total_cartons" optional="hide"/>
                <field name="total_amount" optional="show" groups="base.group_system"/>
                <field name="state" optional="show"/>
            </list>
        </field>
    </record>

    <record id="reema_packing_list_form_view" model="ir.ui.view">
        <field name="name">reema.packing.list.form</field>
        <field name="model">reema.packing.list</field>
        <field name="arch" type="xml">
            <form duplicate="false">
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary" invisible="state != 'draft'"
                            confirm="Confirm this Packing List? This will move the Finished Goods value of every batch below into Cost of Goods Sold."/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state != 'confirmed'"
                            confirm="Cancel this Packing List? This will reverse the COGS entry and free up its batches for another Packing List."/>
                    <button name="action_print_packing_list" string="Print" type="object" class="btn-secondary"/>
                    <button class="btn btn-secondary btn-sm"
                            data-bs-toggle="modal"
                            data-bs-target="#reema_pl_status_info_modal"
                            title="Packing List Status Reference"
                            groups="base.group_user">
                        <i class="fa fa-info-circle"/>
                    </button>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <!-- Packing List Status Reference: plain Bootstrap modal (no OWL/wizard) -->
                <div class="modal fade" id="reema_pl_status_info_modal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-lg">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Packing List Status Reference</h5>
                                <a href="#" role="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"/>
                            </div>
                            <div class="modal-body">
                                <table class="table table-sm table-bordered" style="font-size:13px;">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width:140px">Status</th>
                                            <th>What it means &amp; available actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td><span class="badge text-bg-secondary">Draft</span></td>
                                            <td>Being built — add Order/Article lines, quantities and carton details.
                                                Nothing is posted to accounting yet. Actions:
                                                <strong>Confirm</strong> (moves Finished Goods value to Cost of Goods
                                                Sold for every article below), <strong>Print</strong>.</td>
                                        </tr>
                                        <tr>
                                            <td><span class="badge text-bg-success">Confirmed</span></td>
                                            <td>COGS entry posted — the shipped quantities are locked in and can no
                                                longer be edited. Action: <strong>Cancel</strong> (reverses the COGS
                                                entry and frees the batches back up for another Packing List).</td>
                                        </tr>
                                        <tr>
                                            <td><span class="badge text-bg-danger">Cancelled</span></td>
                                            <td>The COGS entry was reversed. This Packing List is no longer usable —
                                                start a new one for the same shipment if needed.</td>
                                        </tr>
                                    </tbody>
                                </table>
                                <table class="table table-sm table-bordered mt-3" style="font-size:13px;">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width:140px">Button</th>
                                            <th>What it does</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td><strong>Confirm</strong></td>
                                            <td>Posts the Dr COGS / Cr Finished Goods entry for every article line,
                                                using each one's own batch allocation. Only available in Draft.</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Cancel</strong></td>
                                            <td>Reverses the COGS entry with an offsetting entry and frees up the
                                                batches this Packing List had claimed. Only available once Confirmed.</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Print</strong></td>
                                            <td>Opens an HTML preview of the Packing List document in a new tab —
                                                print with Ctrl+P. Available in any status.</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="modal-footer">
                                <a href="#" role="button" class="btn btn-primary" data-bs-dismiss="modal">Close</a>
                            </div>
                        </div>
                    </div>
                </div>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" options="{'no_open': True, 'no_create': True, 'no_edit': True}"
                                   readonly="state != 'draft'"/>
                            <field name="client_address" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="container_no" readonly="state != 'draft'"/>
                            <field name="commercial_invoice_no" readonly="state != 'confirmed'"/>
                        </group>
                        <group>
                            <field name="total_cartons"/>
                            <field name="gross_weight"/>
                            <field name="net_weight"/>
                            <field name="total_amount" groups="base.group_system"/>
                            <field name="account_move_id" readonly="1" groups="base.group_system"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state != 'draft'"
                           context="{'default_packing_list_id': id}">
                        <list editable="bottom">
                            <field name="invoice_id" string="Order"
                                   domain="[('partner_id', '=', parent.partner_id)]"
                                   options="{'no_open': True, 'no_create': True, 'no_edit': True}"/>
                            <field name="pi_line_id" string="Article"
                                   domain="[('invoice_id', '=', invoice_id)]"
                                   options="{'no_open': True, 'no_create': True, 'no_edit': True}"/>
                            <field name="product_id" column_invisible="True"/>
                            <field name="description" optional="show"/>
                            <field name="client_sku" optional="show"/>
                            <field name="sample_color" optional="show"/>
                            <field name="size" optional="show"/>
                            <field name="available_qty" readonly="1"/>
                            <field name="qty"/>
                            <field name="carton_size"/>
                            <field name="qty_per_carton"/>
                            <field name="carton_qty"/>
                            <field name="carton_last_qty" readonly="1" optional="show"/>
                            <field name="carton_weight"/>
                            <field name="carton_range" readonly="1" optional="show"/>
                            <field name="sample_code" optional="hide"/>
                            <field name="hs_code" optional="hide"/>
                            <field name="ean" optional="hide"/>
                            <field name="fg_amount" readonly="1" groups="base.group_system"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="reema_packing_list_action" model="ir.actions.act_window">
        <field name="name">Packing Lists</field>
        <field name="res_model">reema.packing.list</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="reema_mrp_menu_operations"
              name="Operations"
              parent="reema_invoice.menu_reema_invoice_root"
              sequence="15"/>

    <menuitem id="reema_mrp_menu_packing_list"
              name="Packing Lists"
              parent="reema_mrp_menu_operations"
              action="reema_packing_list_action"
              groups="base.group_user"
              sequence="20"/>

    <!-- Pro Forma Invoices ("PI") action, moved here alongside Packing Lists. -->
    <record id="reema_invoice.menu_reema_invoice_all" model="ir.ui.menu">
        <field name="name">Proforma Invoice</field>
        <field name="parent_id" ref="reema_mrp_menu_operations"/>
        <field name="sequence">10</field>
    </record>
</odoo>
