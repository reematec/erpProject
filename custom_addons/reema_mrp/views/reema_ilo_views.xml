<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════
         ILO DISPATCH
    ═══════════════════════════════════════════════ -->

    <record id="view_reema_ilo_dispatch_form" model="ir.ui.view">
        <field name="name">reema.ilo.dispatch.form</field>
        <field name="model">reema.ilo.dispatch</field>
        <field name="arch" type="xml">
            <form string="ILO Outward Pass">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Dispatch Info">
                            <field name="mo_id" options="{'no_create': True, 'no_edit': True}" readonly="1"/>
                            <field name="dispatch_type" readonly="1"/>
                            <field name="contractor_id" options="{'no_create': True, 'no_edit': True, 'no_open': True}"
                                   readonly="1"/>
                            <field name="original_contractor_id" options="{'no_open': True}"
                                   readonly="1" invisible="dispatch_type != 'repair'"/>
                            <field name="defect_type" readonly="1" invisible="dispatch_type != 'repair'"/>
                            <field name="date" readonly="1"/>
                            <field name="ball_size" readonly="1"/>
                            <field name="construction_type" readonly="1"/>
                        </group>
                        <group string="Quantities Sent">
                            <field name="product_id" options="{'no_open': True}" readonly="1"/>
                            <field name="qty_balls" readonly="1"/>
                            <field name="rate" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Prepared By">
                            <field name="dispatched_by" options="{'no_create': True, 'no_edit': True, 'no_open': True}"
                                   readonly="1"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Any notes about this dispatch..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_reema_ilo_dispatch_list" model="ir.ui.view">
        <field name="name">reema.ilo.dispatch.list</field>
        <field name="model">reema.ilo.dispatch</field>
        <field name="arch" type="xml">
            <list string="ILO Dispatches">
                <field name="name" optional="show"/>
                <field name="date" string="Date" optional="show"/>
                <field name="mo_id" optional="show"/>
                <field name="dispatch_type" string="Dispatch" optional="show"/>
                <field name="repair_source" string="From" optional="show"/>
                <field name="product_id" options="{'no_open': True}" optional="hide"/>
                <field name="contractor_id" string="Contractor" options="{'no_open': True}" optional="show"/>
                <field name="original_contractor_id" string="Original Contractor" options="{'no_open': True}" optional="show"/>
                <field name="defect_type" optional="hide"/>
                <field name="ball_size" optional="show"/>
                <field name="qty_balls" optional="show"/>
                <field name="rate" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_reema_ilo_dispatch_search" model="ir.ui.view">
        <field name="name">reema.ilo.dispatch.search</field>
        <field name="model">reema.ilo.dispatch</field>
        <field name="arch" type="xml">
            <search string="ILO Dispatches">
                <field name="name"/>
                <field name="mo_id"/>
                <field name="contractor_id"/>
                <filter name="dispatched" string="Dispatched" domain="[('state', '=', 'dispatched')]"/>
                <filter name="sent" string="Sent" domain="[('state', '=', 'sent')]"/>
                <filter name="closed" string="Closed" domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter name="stitching_type" string="Stitching" domain="[('dispatch_type', '=', 'stitching')]"/>
                <filter name="repair_type" string="Repair" domain="[('dispatch_type', '=', 'repair')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_contractor" string="Contractor" context="{'group_by': 'contractor_id'}"/>
                    <filter name="group_mo" string="Manufacturing Order" context="{'group_by': 'mo_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_dispatch_type" string="Dispatch Type" context="{'group_by': 'dispatch_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_reema_ilo_dispatch" model="ir.actions.act_window">
        <field name="name">ILO Dispatches</field>
        <field name="res_model">reema.ilo.dispatch</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_reema_ilo_dispatch_search"/>
    </record>

    <record id="action_reema_ilo_repair_dispatch" model="ir.actions.act_window">
        <field name="name">ILO Repair Dispatches</field>
        <field name="res_model">reema.ilo.dispatch</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('dispatch_type', '=', 'repair')]</field>
        <field name="search_view_id" ref="view_reema_ilo_dispatch_search"/>
    </record>

    <!-- MO smart-button variants — active_id-scoped, opened as a new tab via
         mrp_production._action_view_url_new_tab -->
    <record id="action_reema_ilo_dispatch_from_mo" model="ir.actions.act_window">
        <field name="name">ILO Dispatches</field>
        <field name="res_model">reema.ilo.dispatch</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('mo_id', '=', active_id)]</field>
        <field name="search_view_id" ref="view_reema_ilo_dispatch_search"/>
    </record>

    <record id="action_reema_ilo_repair_dispatch_from_mo" model="ir.actions.act_window">
        <field name="name">ILO Repair Dispatches</field>
        <field name="res_model">reema.ilo.dispatch</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('mo_id', '=', active_id), ('dispatch_type', '=', 'repair')]</field>
        <field name="search_view_id" ref="view_reema_ilo_dispatch_search"/>
    </record>

    <!-- ═══════════════════════════════════════════════
         ILO RECEIVED — the actual reema.wo.batch.entry rows logged at the
         Ball Receive Point work center (own stitching returns AND repair
         returns). These are excluded from the main Batch Logs list (they're
         provisional, not payable there), so this is the only place to see
         them.
    ═══════════════════════════════════════════════ -->

    <record id="view_reema_ilo_receive_entry_list" model="ir.ui.view">
        <field name="name">reema.wo.batch.entry.ilo.receive.list</field>
        <field name="model">reema.wo.batch.entry</field>
        <field name="arch" type="xml">
            <list string="ILO Received" create="0" edit="0" delete="0" default_order="date desc">
                <field name="name" string="Reference"/>
                <field name="date"/>
                <field name="mo_id"/>
                <field name="contractor_id" string="Received From"/>
                <field name="original_contractor_id" string="Original Contractor"/>
                <field name="ilo_dispatch_type" string="ILO Flow" widget="badge"/>
                <field name="qty" string="Qty" sum="Total"/>
                <field name="qty_balls" string="Balls" sum="Total"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <record id="view_reema_ilo_receive_entry_search" model="ir.ui.view">
        <field name="name">reema.wo.batch.entry.ilo.receive.search</field>
        <field name="model">reema.wo.batch.entry</field>
        <field name="arch" type="xml">
            <search string="ILO Received">
                <field name="mo_id"/>
                <field name="contractor_id"/>
                <field name="original_contractor_id"/>
                <filter name="stitching_type" string="Stitching" domain="[('ilo_dispatch_type', '=', 'stitching')]"/>
                <filter name="repair_type" string="Repair" domain="[('ilo_dispatch_type', '=', 'repair')]"/>
                <separator/>
                <filter name="today" string="Today"
                        domain="[('date', '>=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_contractor" string="Received From" context="{'group_by': 'contractor_id'}"/>
                    <filter name="group_original_contractor" string="Original Contractor" context="{'group_by': 'original_contractor_id'}"/>
                    <filter name="group_mo" string="Manufacturing Order" context="{'group_by': 'mo_id'}"/>
                    <filter name="group_ilo_flow" string="ILO Flow" context="{'group_by': 'ilo_dispatch_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_reema_ilo_receive_entry" model="ir.actions.act_window">
        <field name="name">ILO Received</field>
        <field name="res_model">reema.wo.batch.entry</field>
        <field name="view_mode">list</field>
        <field name="domain">[('workorder_id.workcenter_id.is_ball_receive_point', '=', True)]</field>
        <field name="search_view_id" ref="view_reema_ilo_receive_entry_search"/>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_reema_ilo_receive_entry_list')}),
        ]"/>
    </record>

    <!-- ═══════════════════════════════════════════════
         ILO BALANCE (Dispatched vs Received) — real-time ledger,
         used for "Pending" instead of the never-updated dispatch.state
    ═══════════════════════════════════════════════ -->

    <record id="view_reema_ilo_balance_list" model="ir.ui.view">
        <field name="name">reema.ilo.balance.list</field>
        <field name="model">reema.ilo.balance</field>
        <field name="arch" type="xml">
            <list string="ILO Pending" create="0" edit="0" delete="0"
                  decoration-warning="qty_outstanding &gt; 0">
                <field name="mo_id"/>
                <field name="contractor_id"/>
                <field name="dispatch_type" string="ILO Flow" widget="badge"/>
                <field name="qty_dispatched" sum="Total"/>
                <field name="qty_received" sum="Total"/>
                <field name="qty_outstanding" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="view_reema_ilo_balance_search" model="ir.ui.view">
        <field name="name">reema.ilo.balance.search</field>
        <field name="model">reema.ilo.balance</field>
        <field name="arch" type="xml">
            <search string="ILO Pending">
                <field name="mo_id"/>
                <field name="contractor_id"/>
                <filter name="stitching_type" string="Stitching" domain="[('dispatch_type', '=', 'stitching')]"/>
                <filter name="repair_type" string="Repair" domain="[('dispatch_type', '=', 'repair')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_contractor" string="Contractor" context="{'group_by': 'contractor_id'}"/>
                    <filter name="group_mo" string="Manufacturing Order" context="{'group_by': 'mo_id'}"/>
                    <filter name="group_dispatch_type" string="ILO Flow" context="{'group_by': 'dispatch_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_reema_ilo_pending" model="ir.actions.act_window">
        <field name="name">ILO Pending</field>
        <field name="res_model">reema.ilo.balance</field>
        <field name="view_mode">list</field>
        <field name="domain">[('qty_outstanding', '&gt;', 0)]</field>
        <field name="search_view_id" ref="view_reema_ilo_balance_search"/>
    </record>

    <!-- ═══════════════════════════════════════════════
         ILO FLOW — combined, chronological feed of Dispatches AND Received
         together (union of reema.ilo.dispatch + the receive-point rows of
         reema.wo.batch.entry). Testing replacement for the two separate
         menus — read-only, doesn't touch either source model.
    ═══════════════════════════════════════════════ -->

    <record id="view_reema_ilo_flow_list" model="ir.ui.view">
        <field name="name">reema.ilo.flow.list</field>
        <field name="model">reema.ilo.flow</field>
        <field name="arch" type="xml">
            <list string="ILO Flow" create="0" edit="0" delete="0" default_order="date desc">
                <field name="reference" optional="show"/>
                <field name="date" optional="show"/>
                <field name="mo_id" optional="show"/>
                <field name="contractor_id" optional="show"/>
                <field name="original_contractor_id" optional="show"/>
                <field name="dispatch_type" string="ILO Flow" widget="badge" optional="show"/>
                <field name="process" widget="badge" optional="show"/>
                <field name="direction" widget="badge"
                       decoration-warning="direction == 'dispatched'"
                       decoration-success="direction == 'received'"
                       optional="show"/>
                <field name="qty_sent" widget="zero_dash_float" sum="Total" optional="show"/>
                <field name="qty_received" widget="zero_dash_float" sum="Total" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_reema_ilo_flow_search" model="ir.ui.view">
        <field name="name">reema.ilo.flow.search</field>
        <field name="model">reema.ilo.flow</field>
        <field name="arch" type="xml">
            <search string="ILO Flow">
                <field name="reference"/>
                <field name="mo_id"/>
                <field name="contractor_id"/>
                <field name="original_contractor_id"/>
                <filter name="dispatched" string="Dispatched" domain="[('direction', '=', 'dispatched')]"/>
                <filter name="received" string="Received" domain="[('direction', '=', 'received')]"/>
                <separator/>
                <filter name="stitching_type" string="Stitching" domain="[('dispatch_type', '=', 'stitching')]"/>
                <filter name="repair_type" string="Repair" domain="[('dispatch_type', '=', 'repair')]"/>
                <separator/>
                <filter name="initial_qc_process" string="Initial QC" domain="[('process', '=', 'initial_qc')]"/>
                <filter name="final_qc_process" string="Final QC" domain="[('process', '=', 'final_qc')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_direction" string="Direction" context="{'group_by': 'direction'}"/>
                    <filter name="group_process" string="Process" context="{'group_by': 'process'}"/>
                    <filter name="group_contractor" string="Contractor" context="{'group_by': 'contractor_id'}"/>
                    <filter name="group_original_contractor" string="Original Contractor" context="{'group_by': 'original_contractor_id'}"/>
                    <filter name="group_mo" string="Manufacturing Order" context="{'group_by': 'mo_id'}"/>
                    <filter name="group_dispatch_type" string="ILO Flow" context="{'group_by': 'dispatch_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_reema_ilo_flow" model="ir.actions.act_window">
        <field name="name">ILO Flow</field>
        <field name="res_model">reema.ilo.flow</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_reema_ilo_flow_search"/>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_reema_ilo_flow_list')}),
        ]"/>
    </record>

    <!-- Stored variant scoped to one MO via active_id — needed so the "Balls Done"
         click-through (action_view_ilo_flow on mrp.workorder) can address it by a
         real numeric action id and open it as a new browser tab
         (/odoo/<active_id>/action-<id>), which a plain inline action dict cannot do.
         The menu-driven action_reema_ilo_flow above stays domain-less/unscoped. -->
    <record id="action_reema_ilo_flow_from_workorder" model="ir.actions.act_window">
        <field name="name">ILO Flow</field>
        <field name="res_model">reema.ilo.flow</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_reema_ilo_flow_search"/>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_reema_ilo_flow_list')}),
        ]"/>
        <field name="domain">[('mo_id', '=', active_id)]</field>
        <field name="context">{'search_default_group_contractor': 1}</field>
    </record>

    <!-- ═══════════════════════════════════════════════
         GATE STAFF — OUTWARD PASS (READ-ONLY)
         Dispatch is finalized the moment it's logged, so there's nothing for
         gate staff to confirm here — this is just the dispatch paper, shown
         read-only for reference. A real gate-check workflow is follow-up work.
    ═══════════════════════════════════════════════ -->

    <record id="view_reema_ilo_dispatch_form_gate" model="ir.ui.view">
        <field name="name">reema.ilo.dispatch.form.gate</field>
        <field name="model">reema.ilo.dispatch</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <form string="Outward Pass" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Pass Details">
                            <field name="mo_id" readonly="1"/>
                            <field name="contractor_id" readonly="1"/>
                            <field name="date" readonly="1"/>
                            <field name="ball_size" readonly="1"/>
                            <field name="construction_type" readonly="1"/>
                        </group>
                        <group string="Quantities">
                            <field name="qty_balls" readonly="1"/>
                        </group>
                    </group>
                    <field name="state" widget="statusbar" statusbar_visible="dispatched,sent,closed" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_reema_ilo_dispatch_list_gate" model="ir.ui.view">
        <field name="name">reema.ilo.dispatch.list.gate</field>
        <field name="model">reema.ilo.dispatch</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list string="Outward Passes" create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="date"/>
                <field name="contractor_id"/>
                <field name="qty_balls"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'dispatched'"
                       decoration-info="state == 'sent'"
                       decoration-success="state == 'closed'"/>
            </list>
        </field>
    </record>

    <record id="view_reema_ilo_dispatch_search_gate" model="ir.ui.view">
        <field name="name">reema.ilo.dispatch.search.gate</field>
        <field name="model">reema.ilo.dispatch</field>
        <field name="arch" type="xml">
            <search string="Outward Passes">
                <field name="name" string="Reference"/>
                <field name="contractor_id"/>
                <filter name="pending" string="Pending at ILO" domain="[('state', 'in', ('dispatched', 'sent'))]"/>
            </search>
        </field>
    </record>

    <record id="action_reema_ilo_dispatch_gate" model="ir.actions.act_window">
        <field name="name">Outward Passes</field>
        <field name="res_model">reema.ilo.dispatch</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_reema_ilo_dispatch_search_gate"/>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_reema_ilo_dispatch_list_gate')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_reema_ilo_dispatch_form_gate')}),
        ]"/>
    </record>

    <!-- ═══════════════════════════════════════════════
         ILO RECEIPT
    ═══════════════════════════════════════════════ -->

    <record id="view_reema_ilo_receipt_form" model="ir.ui.view">
        <field name="name">reema.ilo.receipt.form</field>
        <field name="model">reema.ilo.receipt</field>
        <field name="arch" type="xml">
            <form string="ILO Receipt">
                <header>
                    <button name="action_receive" string="Confirm Receipt" type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"
                            confirm="Confirm this receipt? The returned quantity will be recorded against the dispatch."/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,received"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Linked To">
                            <field name="dispatch_id" options="{'no_create': True, 'no_edit': True}"
                                   readonly="state != 'draft'"/>
                            <field name="contractor_id"/>
                            <field name="mo_id"/>
                            <field name="ball_size"/>
                            <field name="construction_type"/>
                        </group>
                        <group string="Receipt Info">
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="received_by" options="{'no_create': True, 'no_edit': True}"
                                   readonly="state != 'draft'"/>
                            <field name="verified_by" options="{'no_create': True, 'no_edit': True}"
                                   readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group string="Returned Quantities">
                        <group>
                            <field name="qty_full" readonly="state != 'draft'"/>
                            <field name="qty_no_bladder" readonly="state != 'draft'"/>
                            <field name="qty_damaged" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group string="Payment Calculation">
                        <group>
                            <field name="piece_rate_id"
                                   options="{'no_create': True, 'no_edit': True}"
                                   readonly="state != 'draft'"/>
                            <field name="rate_full" readonly="state != 'draft'"/>
                            <field name="deduction_per_ball" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="amount_full"/>
                            <field name="amount_no_bladder"/>
                            <field name="repair_deduction"/>
                            <field name="amount_due" class="fw-bold"/>
                        </group>
                    </group>
                    <field name="notes" readonly="state != 'draft'" placeholder="Any notes about this receipt..."/>
                    <notebook>
                        <page string="QC Repair Charges" name="repair_charges">
                            <div class="alert alert-info py-2 mb-2" role="alert" style="font-size:0.85rem">
                                <i class="fa fa-info-circle me-1"/>
                                QC repair charges are recorded by QC staff after initial quality inspection.
                                Each entry deducts from the contractor's amount due.
                            </div>
                            <field name="repair_charge_ids">
                                <list editable="bottom" string="Repair Charges">
                                    <field name="date"/>
                                    <field name="recorded_by" options="{'no_create': True, 'no_edit': True}"/>
                                    <field name="qty_failed"/>
                                    <field name="repair_charge_per_ball"/>
                                    <field name="total_deduction"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_reema_ilo_receipt_list" model="ir.ui.view">
        <field name="name">reema.ilo.receipt.list</field>
        <field name="model">reema.ilo.receipt</field>
        <field name="arch" type="xml">
            <list string="ILO Receipts">
                <field name="name"/>
                <field name="date"/>
                <field name="dispatch_id"/>
                <field name="contractor_id"/>
                <field name="qty_full"/>
                <field name="qty_no_bladder"/>
                <field name="qty_damaged"/>
                <field name="repair_deduction"/>
                <field name="amount_due" string="Amount Due (PKR)"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'draft'"
                       decoration-success="state == 'received'"/>
            </list>
        </field>
    </record>

    <record id="view_reema_ilo_receipt_search" model="ir.ui.view">
        <field name="name">reema.ilo.receipt.search</field>
        <field name="model">reema.ilo.receipt</field>
        <field name="arch" type="xml">
            <search string="ILO Receipts">
                <field name="name"/>
                <field name="dispatch_id"/>
                <field name="contractor_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="received" string="Received" domain="[('state', '=', 'received')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_contractor" string="Contractor" context="{'group_by': 'contractor_id'}"/>
                    <filter name="group_mo" string="Manufacturing Order" context="{'group_by': 'mo_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_reema_ilo_receipt" model="ir.actions.act_window">
        <field name="name">ILO Receipts</field>
        <field name="res_model">reema.ilo.receipt</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_reema_ilo_receipt_search"/>
    </record>

    <!-- ═══════════════════════════════════════════════
         ILO PAYMENTS
    ═══════════════════════════════════════════════ -->

    <record id="view_reema_ilo_payment_form" model="ir.ui.view">
        <field name="name">reema.ilo.payment.form</field>
        <field name="model">reema.ilo.payment</field>
        <field name="arch" type="xml">
            <form string="ILO Payment">
                <header>
                    <button name="action_confirm" string="Confirm Payment" type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"
                            confirm="Confirm this payment?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="contractor_id" options="{'no_create': True, 'no_edit': True}"
                                   readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="payment_type" readonly="state != 'draft'"/>
                            <field name="amount" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <field name="notes" readonly="state != 'draft'" placeholder="Payment notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_reema_ilo_payment_list" model="ir.ui.view">
        <field name="name">reema.ilo.payment.list</field>
        <field name="model">reema.ilo.payment</field>
        <field name="arch" type="xml">
            <list string="ILO Payments">
                <field name="name"/>
                <field name="date"/>
                <field name="contractor_id"/>
                <field name="payment_type"/>
                <field name="amount" string="Amount (PKR)" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'draft'"
                       decoration-success="state == 'confirmed'"/>
            </list>
        </field>
    </record>

    <record id="action_reema_ilo_payment" model="ir.actions.act_window">
        <field name="name">ILO Payments</field>
        <field name="res_model">reema.ilo.payment</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ═══════════════════════════════════════════════
         ILO QC SCRAP
    ═══════════════════════════════════════════════ -->

    <record id="view_reema_ilo_qc_scrap_list" model="ir.ui.view">
        <field name="name">reema.ilo.qc.scrap.list</field>
        <field name="model">reema.ilo.qc.scrap</field>
        <field name="arch" type="xml">
            <list string="ILO QC Scrap" create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="mo_id"/>
                <field name="workcenter_id" string="Hall"/>
                <field name="contractor_id"/>
                <field name="qty" string="Balls Scrapped" sum="Total"/>
                <field name="defect_type"/>
                <field name="recorded_by"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <record id="action_reema_ilo_qc_scrap" model="ir.actions.act_window">
        <field name="name">ILO QC Scrap</field>
        <field name="res_model">reema.ilo.qc.scrap</field>
        <field name="view_mode">list</field>
    </record>

    <!-- ═══════════════════════════════════════════════
         ILO CONTRACTOR DEDUCTIONS — repair charge / scrap material cost
         charged to the original stitching contractor, created at Final QC.
         Pending until applied as a line on that contractor's next bill.
    ═══════════════════════════════════════════════ -->

    <record id="view_reema_ilo_contractor_deduction_list" model="ir.ui.view">
        <field name="name">reema.ilo.contractor.deduction.list</field>
        <field name="model">reema.ilo.contractor.deduction</field>
        <field name="arch" type="xml">
            <list string="ILO Contractor Deductions" create="0" edit="0" delete="0" default_order="date desc">
                <header>
                    <button name="action_apply_selected_to_bill" type="object"
                            string="Add to Bill" class="btn-primary"
                            invisible="not context.get('reema_pick_bill_id')"/>
                </header>
                <field name="name" string="Reference" optional="show"/>
                <field name="date" optional="show"/>
                <field name="original_contractor_id" optional="show"/>
                <field name="charged_contractor_id" string="Charged To" optional="hide"/>
                <field name="deduction_type" string="Type" widget="badge" optional="show"/>
                <field name="reema_product_id" string="Product" optional="show"/>
                <field name="mo_id" optional="show"/>
                <field name="reema_po_id" string="PO" optional="hide"/>
                <field name="qty" optional="show"/>
                <field name="construction_type" optional="show"/>
                <field name="rate" widget="zero_dash_float" optional="show"/>
                <field name="amount" optional="show"/>
                <field name="state" string="Status" widget="badge"
                       decoration-warning="state == 'pending'"
                       decoration-success="state == 'applied'"
                       optional="show"/>
                <field name="repair_batch_entry_id" string="Repair Contractor Entry" optional="hide"/>
                <field name="bill_id" optional="hide"/>
                <field name="recorded_by" optional="hide"/>
                <field name="notes" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_reema_ilo_contractor_deduction_search" model="ir.ui.view">
        <field name="name">reema.ilo.contractor.deduction.search</field>
        <field name="model">reema.ilo.contractor.deduction</field>
        <field name="arch" type="xml">
            <search string="ILO Contractor Deductions">
                <field name="original_contractor_id"/>
                <field name="mo_id"/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="applied" string="Applied" domain="[('state', '=', 'applied')]"/>
                <separator/>
                <filter name="repair_type" string="Repair Charge" domain="[('deduction_type', '=', 'repair')]"/>
                <filter name="scrap_type" string="Scrap Material Cost" domain="[('deduction_type', '=', 'scrap')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_contractor" string="Original Contractor" context="{'group_by': 'original_contractor_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'deduction_type'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_mo" string="Manufacturing Order" context="{'group_by': 'mo_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_reema_ilo_contractor_deduction" model="ir.actions.act_window">
        <field name="name">ILO Contractor Deductions</field>
        <field name="res_model">reema.ilo.contractor.deduction</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="search_view_id" ref="view_reema_ilo_contractor_deduction_search"/>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_reema_ilo_contractor_deduction_list')}),
        ]"/>
    </record>

    <!-- MO smart-button variant — active_id-scoped, opened as a new tab via
         mrp_production._action_view_url_new_tab. Lost-ball charges only. -->
    <record id="action_reema_lost_balls_from_mo" model="ir.actions.act_window">
        <field name="name">Lost Balls</field>
        <field name="res_model">reema.ilo.contractor.deduction</field>
        <field name="view_mode">list</field>
        <field name="domain">[('mo_id', '=', active_id), ('deduction_type', '=', 'lost')]</field>
        <field name="search_view_id" ref="view_reema_ilo_contractor_deduction_search"/>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_reema_ilo_contractor_deduction_list')}),
        ]"/>
    </record>

    <!-- ═══════════════════════════════════════════════
         MENUS
    ═══════════════════════════════════════════════ -->

