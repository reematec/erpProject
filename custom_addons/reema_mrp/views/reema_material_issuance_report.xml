<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_material_issuance_slip">
        <t t-call="web.html_container">
            <style>
                @media print {
                    .issuance_doc { page-break-after: always; }
                    .issuance_doc:last-child { page-break-after: auto; }
                }
                @page { margin: 12mm; }
            </style>
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page issuance_doc">

                        <!-- Title -->
                        <div class="row mt-2 mb-2">
                            <div class="col-12">
                                <div style="font-size:15px; font-weight:700; margin-bottom:1px;">
                                    <span t-field="doc.name"/>
                                    <br/>
                                    <span t-field="doc.product_id"/>
                                </div>
                            </div>
                        </div>

                        <hr style="margin-top:4px;"/>

                        <!-- Header details -->
                        <t t-set="po" t-value="doc.production_id.sudo().reema_po_line_ids[:1].order_id"/>
                        <div class="row mt-3">
                            <div class="col-6">
                                <table class="table table-sm table-borderless" style="font-size:13px;">
                                    <tr t-if="po">
                                        <td style="width:45%;"><strong>Production Order</strong></td>
                                        <td><t t-esc="po.name"/></td>
                                    </tr>
                                    <tr>
                                        <td style="width:45%;"><strong>Manufacturing Order</strong></td>
                                        <td><t t-esc="doc.production_name or (doc.production_id and doc.production_id.name)"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>UOM</strong></td>
                                        <td><span t-field="doc.product_uom_id"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Authorized On</strong></td>
                                        <td><span t-field="doc.date_authorized"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Authorized By</strong></td>
                                        <td><t t-esc="doc.authorized_by.name"/></td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-6">
                                <table class="table table-sm table-borderless" style="font-size:13px;">
                                    <tr>
                                        <td style="width:45%;"><strong>Status</strong></td>
                                        <td><t t-esc="dict(doc.fields_get(['state'])['state']['selection']).get(doc.state, doc.state)"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Authorized Qty</strong></td>
                                        <td><span t-field="doc.authorized_qty"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Net Issued</strong></td>
                                        <td><span t-field="doc.net_issued_qty"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Remaining</strong></td>
                                        <td><span t-field="doc.remaining_qty"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Issue Log -->
                        <h5 class="mt-3 mb-1">Issue History</h5>
                        <table class="table table-sm table-striped" style="font-size:12px;">
                            <thead>
                                <tr class="table-dark">
                                    <th>#</th>
                                    <th>Date</th>
                                    <th class="text-end">Qty</th>
                                    <th>Hall</th>
                                    <th>Contractor</th>
                                    <th>Carried By</th>
                                    <th>Issued By</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.line_ids" t-as="line">
                                    <tr t-att-class="'text-muted fst-italic' if line.is_reversal else ''">
                                        <td><t t-esc="line_index + 1"/></td>
                                        <td><span t-field="line.date"/></td>
                                        <td class="text-end"><t t-out="('%.6f' % line.issued_qty).rstrip('0').rstrip('.')"/></td>
                                        <td><t t-esc="line.destination_location_id.name"/></td>
                                        <td><t t-esc="line.contractor_id.name"/></td>
                                        <td><t t-esc="line.carried_by"/></td>
                                        <td><t t-esc="line.issued_by.name"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Signatures -->
                        <div class="row mt-5">
                            <div class="col-4 text-center">
                                <div style="border-top:1px solid #000; padding-top:4px; font-size:12px;">
                                    Authorized By (Production Manager)
                                </div>
                            </div>
                            <div class="col-4 text-center">
                                <div style="border-top:1px solid #000; padding-top:4px; font-size:12px;">
                                    Issued By (Store Keeper)
                                </div>
                            </div>
                            <div class="col-4 text-center">
                                <div style="border-top:1px solid #000; padding-top:4px; font-size:12px;">
                                    Received By (Contractor)
                                </div>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
