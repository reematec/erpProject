<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="reema_consumable_stock_take_view_form" model="ir.ui.view">
        <field name="name">reema.consumable.stock.take.form</field>
        <field name="model">reema.consumable.stock.take</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_load_lines" type="object" string="Load Lines"
                            invisible="state != 'draft'" class="btn-secondary"/>
                    <button name="action_confirm" type="object" string="Confirm"
                            invisible="state != 'draft'" class="btn-primary"
                            confirm="Confirm this stock take? This posts accounting entries for every line with a consumed value."/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state != 'confirmed'"
                            confirm="Cancel this stock take? All its accounting entries will be reversed."/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="total_consumed_value" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="location_id" string="Hall"
                                           options="{'no_create': True, 'no_edit': True}"/>
                                    <field name="product_id" string="Consumable"
                                           options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                                    <field name="product_uom_id" string="UOM" readonly="1" optional="show"/>
                                    <field name="window_start_date" string="Since" readonly="1" optional="hide"/>
                                    <field name="opening_qty" readonly="1" optional="show"/>
                                    <field name="issued_qty" readonly="1" optional="show"/>
                                    <field name="returned_qty" readonly="1" optional="show"/>
                                    <field name="expected_qty" readonly="1"/>
                                    <field name="counted_qty"/>
                                    <field name="variance_qty" readonly="1" optional="show"/>
                                    <field name="consumed_qty" readonly="1" optional="show"/>
                                    <field name="unit_cost" readonly="1" optional="show"/>
                                    <field name="consumed_value" readonly="1"/>
                                    <field name="allocation_note" readonly="1" optional="hide"/>
                                    <field name="account_move_id" readonly="1" optional="hide"/>
                                    <field name="take_state" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="reema_consumable_stock_take_view_list" model="ir.ui.view">
        <field name="name">reema.consumable.stock.take.list</field>
        <field name="model">reema.consumable.stock.take</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="state"/>
                <field name="total_consumed_value"/>
            </list>
        </field>
    </record>

    <record id="reema_consumable_stock_take_action" model="ir.actions.act_window">
        <field name="name">Consumable Stock Take</field>
        <field name="res_model">reema.consumable.stock.take</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="reema_mrp_menu_consumable_stock_take"
              name="Consumable Stock Take"
              parent="reema_mrp_menu_issuances_root"
              action="reema_consumable_stock_take_action"
              groups="base.group_user"
              sequence="3"/>
</odoo>
