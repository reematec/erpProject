<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        HTML preview report for a Bill of Materials, mirroring the sampling report:
        - report_type="qweb-html" (no PDF/wkhtmltopdf).
        - No binding_model_id: kept OUT of the cog Print menu. The header "Print"
          button calls action_print_bom(), which opens /report/html/... in a new tab;
          the user prints with the browser.
    -->
    <record id="action_report_bom" model="ir.actions.report">
        <field name="name">Bill of Materials</field>
        <field name="model">mrp.bom</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">reema_mrp.report_bom</field>
        <field name="report_file">reema_mrp.report_bom</field>
        <field name="print_report_name">'BOM - %s' % (object.reema_reference)</field>
    </record>

    <template id="report_bom">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">

                        <style>
                            @page { margin: 12mm; }
                        </style>

                        <!-- Title: reference and product on separate lines -->
                        <div class="row mt-2 mb-2">
                            <div class="col-12">
                                <div style="font-size:15px; font-weight:700; margin-bottom:1px;">
                                    <span t-field="o.reema_reference"/>
                                    <br/>
                                    <span t-field="o.product_tmpl_id"/>
                                </div>
                            </div>
                        </div>

                        <hr style="margin-top:4px;"/>

                        <!-- Basic details -->
                        <div class="row mt-3">
                            <div class="col-6">
                                <table class="table table-sm table-borderless" style="font-size:13px;">
                                    <tr>
                                        <td style="width:45%;"><strong>Quantity</strong></td>
                                        <td><span t-field="o.product_qty"/> <span t-field="o.product_uom_id"/></td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-6">
                                <table class="table table-sm table-borderless" style="font-size:13px;">
                                    <tr>
                                        <td style="width:50%;"><strong>Impressions / Ball</strong></td>
                                        <td><span t-field="o.impressions_per_ball"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Components -->
                        <h5 class="mt-3 mb-1" style="font-size:13px; font-weight:700;">Components</h5>
                        <table class="table table-sm table-striped" style="font-size:12px;">
                            <thead>
                                <tr class="table-dark">
                                    <th>Material</th>
                                    <th class="text-end">Quantity</th>
                                    <th>UOM</th>
                                    <th>Consuming Operation</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.bom_line_ids" t-as="line">
                                    <tr>
                                        <td><span t-field="line.product_id"/></td>
                                        <td class="text-end"><span t-field="line.product_qty"/></td>
                                        <td><span t-field="line.product_uom_id"/></td>
                                        <td><span t-esc="line.operation_id.name"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Operations -->
                        <t t-if="o.operation_ids">
                            <h5 class="mt-3 mb-1" style="font-size:13px; font-weight:700;">Operations</h5>
                            <table class="table table-sm table-striped" style="font-size:12px;">
                                <thead>
                                    <tr class="table-dark">
                                        <th>Operation</th>
                                        <th>Work Center</th>
                                        <th class="text-end">Balls / Unit</th>
                                        <th>Pay Basis</th>
                                        <th>Piece Rate</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.operation_ids" t-as="op">
                                        <tr>
                                            <td><span t-esc="op.name"/></td>
                                            <td><span t-field="op.workcenter_id"/></td>
                                            <td class="text-end"><span t-out="('%.6f' % op.balls_per_unit).rstrip('0').rstrip('.')"/></td>
                                            <td><span t-field="op.workcenter_id.pay_basis"/></td>
                                            <td><span t-field="op.piece_rate_id"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
