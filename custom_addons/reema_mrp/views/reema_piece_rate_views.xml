<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List / Overview -->
    <record id="reema_piece_rate_view_list" model="ir.ui.view">
        <field name="name">reema.piece.rate.list</field>
        <field name="model">reema.piece.rate</field>
        <field name="arch" type="xml">
            <list string="Piece Rates">
                <header>
                    <button name="action_print_piece_rate_report" string="Print"
                            type="object" display="always" class="btn-secondary"/>
                </header>
                <field name="workcenter_id" string="Work Center"/>
                <field name="work_type"     string="Type of Work"/>
                <field name="description"   string="Description / Notes"/>
                <field name="rate"          string="Rate (PKR)"/>
                <field name="uom_id"        string="UOM"/>
            </list>
        </field>
    </record>

    <!-- Form — opens when user clicks New or an existing row -->
    <record id="reema_piece_rate_view_form" model="ir.ui.view">
        <field name="name">reema.piece.rate.form</field>
        <field name="model">reema.piece.rate</field>
        <field name="arch" type="xml">
            <form string="Piece Rate">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="work_type" placeholder="Type of Work…"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Work Details">
                            <field name="workcenter_id"
                                   options="{'no_create': True, 'no_edit': True}"/>
                            <field name="description"/>
                        </group>
                        <group string="Rate">
                            <field name="rate"/>
                            <field name="uom_id"
                                   options="{'no_create': True, 'no_edit': True}"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search view with groupby option -->
    <record id="reema_piece_rate_view_search" model="ir.ui.view">
        <field name="name">reema.piece.rate.search</field>
        <field name="model">reema.piece.rate</field>
        <field name="arch" type="xml">
            <search string="Piece Rates">
                <field name="workcenter_id"/>
                <field name="work_type"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_workcenter" string="Work Center" context="{'group_by': 'workcenter_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window action: list first, form on New/row click -->
    <record id="reema_piece_rate_action" model="ir.actions.act_window">
        <field name="name">Piece Rates</field>
        <field name="res_model">reema.piece.rate</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="reema_piece_rate_view_list"/>
        <field name="search_view_id" ref="reema_piece_rate_view_search"/>
        <field name="context">{'search_default_group_by_workcenter': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No piece rates defined yet. Click New to add one.
            </p>
        </field>
    </record>

    <!-- Report action: HTML preview of all rates grouped by work center -->
    <record id="action_report_piece_rate_list" model="ir.actions.report">
        <field name="name">Piece Rate List</field>
        <field name="model">reema.piece.rate</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">reema_mrp.report_piece_rate_list</field>
        <field name="report_file">reema_mrp.report_piece_rate_list</field>
        <field name="print_report_name">'Piece Rates'</field>
    </record>

    <!-- Menu: Manufacturing → Configuration → Piece Rates -->
    <menuitem id="reema_mrp_menu_piece_rates"
              name="Piece Rates"
              parent="mrp.menu_mrp_configuration"
              action="reema_piece_rate_action"
              groups="base.group_user"
              sequence="20"/>

</odoo>
